---
import { withBase } from '../lib/routes';
interface Props { name: string; caption: readonly [string,string]; }
const {name,caption}=Astro.props;
const url=(locale:string)=>withBase(`/data/execution-costs/${name}.${locale}.svg`,import.meta.env.BASE_URL);
---
<figure class="study-figure">
  <div><img loading="lazy" src={url('en')} alt={caption[0]} data-locale-image
    data-image-en={url('en')} data-image-zh={url('zh')} data-alt-en={caption[0]} data-alt-zh={caption[1]} /></div>
  <figcaption data-locale-text data-en={caption[0]} data-zh={caption[1]}>{caption[0]}</figcaption>
</figure>
<style>
  .study-figure{margin:1.25rem 0;max-width:100%;min-width:0}
  .study-figure>div{overflow-x:auto;max-width:100%}
  img{display:block;width:100%;min-width:720px;background:white}
  figcaption{font-size:13px;line-height:1.6;margin-top:.6rem;color:var(--text-muted)}
</style>

---
import MicrocapWindowReview from './MicrocapWindowReview.astro';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { hubCopy as c, researchQuestions, revisions, openQuestions } from '../../content/microcap-hub';
import Text from './HubText.astro';
import { withBase } from '../../lib/routes';
const link = (path: string) => path.startsWith('#') ? path : withBase(path, import.meta.env.BASE_URL);
const snapshot = JSON.parse(await readFile(resolve(process.cwd(), 'public/data/low_turnover_exploration.json'), 'utf8'));
const rows = snapshot.window_sensitivity as Array<{window_days: number; net_annual_return: number; net_max_drawdown: number; annualized_turnover: number}>;
const definitions = [{id:'mean_20',label:c.mean20},{id:'mean_60',label:c.mean60},{id:'median_60',label:c.median60},{id:'mean_120',label:c.mean120}];
const cadences = [{id:'weekly',label:c.weekly},{id:'biweekly',label:c.biweekly},{id:'monthly',label:c.monthly},{id:'quarterly',label:c.quarterly}];
const matrix = snapshot.joint_matrix as Array<{turnover_definition:string;rebalance_frequency:string;net_annual_return:number}>;
const matrixMax = Math.max(...matrix.map(r => Math.abs(r.net_annual_return)));
const metrics = [
 { id: 'return', label: c.return, value: (r: typeof rows[number]) => r.net_annual_return, unit: '%' },
 { id: 'drawdown', label: c.drawdown, value: (r: typeof rows[number]) => r.net_max_drawdown, unit: '%' },
 { id: 'turnover', label: c.turnover, value: (r: typeof rows[number]) => r.annualized_turnover, unit: '×' },
];
---
<section id="microcap-report-downloads" class="panel hub-section">
  <h2><Text text={c.reportTitle} /></h2><p><Text text={c.reportDescription} /></p>
  <p><a class="button-link" href={link('/research/microcap/report/')}><Text text={c.readReport} /></a></p>
  <p><a class="download-en button-link" href={link('/downloads/microcap-research.en-US.md')} download="microcap-research.en-US.md"><Text text={c.downloadReport} /> · English</a><a class="download-zh button-link" href={link('/downloads/microcap-research.zh-CN.md')} download="microcap-research.zh-CN.md"><Text text={c.downloadReport} /> · <span data-locale-text data-en="Chinese" data-zh="中文">Chinese</span></a></p>
  <p class="panel-note"><Text text={c.reportFormats} /></p>
</section>
<section id="microcap-map" class="hub-section">
  <h2><Text text={c.title} /></h2><p><Text text={c.intro} /></p><p class="panel-note"><Text text={c.scope} /></p>
  <div class="hub-grid">{researchQuestions.map(q => <article class="research-card">
    <span class="tag"><Text text={q.status} /></span><h3><Text text={q.title} /></h3><p><Text text={q.finding} /></p>
    <dl><dt><Text text={c.sample} /></dt><dd><Text text={q.sample} /></dd><dt><Text text={c.next} /></dt><dd><Text text={q.next} /></dd></dl>
    <a href={link(q.href)}><Text text={q.action} /></a>
  </article>)}</div>
</section>
<section id="microcap-window-evidence" class="panel hub-section" data-metric-explorer>
  <h2><Text text={c.windows} /></h2><p><Text text={c.windowIntro} /></p><p class="panel-note"><Text text={c.windowScope} /></p>
  <div class="hub-controls" hidden data-metric-controls>{metrics.map((m, i) => <button type="button" data-metric={m.id} aria-pressed={i === 0} aria-controls={`window-${m.id}`}><Text text={m.label} /></button>)}</div>
  {metrics.map(m => {
    const max = Math.max(...rows.map(r => Math.abs(m.value(r))));
    return <figure id={`window-${m.id}`} data-metric-panel={m.id}>
      <figcaption><Text text={m.label} /></figcaption>
      <div class="hub-bars">{rows.map(r => <div class="hub-bar-row">
        <span>{r.window_days} <span data-locale-text data-en="days" data-zh="日">days</span></span>
        <div class:list={['hub-bar-track', {loss: m.id === 'drawdown'}]}><span class="hub-bar" style={`width:${Math.abs(m.value(r)) / max * 100}%`}></span></div>
        <strong>{m.value(r).toFixed(2)}{m.unit}</strong>
      </div>)}</div>
    </figure>;
  })}
  <MicrocapWindowReview />
  <p class="panel-note"><Text text={c.chartNote} /></p><p class="callout"><Text text={c.windowCaveat} /></p>
  <details><summary><Text text={c.numbers} /></summary>
    <div class="table-scroll"><table><thead><tr><th><Text text={c.days} /></th>{metrics.map(m => <th><Text text={m.label} /></th>)}</tr></thead><tbody>{rows.map(r => <tr><th>{r.window_days}</th>{metrics.map(m => <td>{m.value(r).toFixed(2)}{m.unit}</td>)}</tr>)}</tbody></table></div>
    <p><a href={link('/data/low_turnover_exploration.json')}><Text text={c.source} /></a></p><p><a href={link('/docs/research/factors/low-turnover/')}><Text text={c.method} /></a></p>
  </details>
</section>
<section id="microcap-rule-matrix" class="panel hub-section">
  <h2><Text text={c.matrix} /></h2><p><Text text={c.matrixIntro} /></p>
  <p class="panel-note"><Text text={c.matrixBoundary} /></p>
  <div class="table-scroll"><table class="hub-matrix"><caption><Text text={c.return} /> (%)</caption><thead><tr><th><Text text={c.days} /></th>{cadences.map(f => <th scope="col"><Text text={f.label} /></th>)}</tr></thead><tbody>{definitions.map(d => <tr><th scope="row"><Text text={d.label} /></th>{cadences.map(f => {
    const row = matrix.find(r => r.turnover_definition === d.id && r.rebalance_frequency === f.id);
    return <td style={row ? `background:color-mix(in srgb,var(--accent) ${6 + Math.abs(row.net_annual_return) / matrixMax * 24}%,transparent)` : ''}>{row ? `${row.net_annual_return.toFixed(2)}%` : '—'}</td>;
  })}</tr>)}</tbody></table></div>
  <p><a href={link('/data/low_turnover_exploration.json')}><Text text={c.source} /></a></p>
</section>
<section id="microcap-revisions" class="panel hub-section">
  <h2><Text text={c.revisions} /></h2><p><Text text={c.revisionsIntro} /></p>
  <ol class="hub-revisions">{revisions.map(r => <li><h3><Text text={r.title} /></h3><p><Text text={r.text} /></p></li>)}</ol>
  <p><a href={link('/docs/research/factors/microcap/')}><Text text={c.revisionSource} /></a></p>
</section>
<section id="microcap-open-questions" class="hub-section">
  <h2><Text text={c.open} /></h2><p><Text text={c.openIntro} /></p>
  <div class="hub-grid">{openQuestions.map(q => <article class="research-card"><span class="tag"><Text text={c.unpublished} /></span><h3><Text text={q.title} /></h3><p><Text text={q.text} /></p></article>)}</div>
</section>
<style>
:global(html:not([lang="zh-CN"])) .download-zh { display: none; }
:global(html[lang="zh-CN"]) .download-en { display: none; }
.hub-section { margin-block: 2rem; scroll-margin-top: 16rem; }
.hub-section h2 { margin-bottom: .8rem; }
.hub-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.2rem; }
.hub-grid article { display: flex; flex-direction: column; gap: .6rem; min-width: 0; }
.hub-grid h3, .hub-grid p { margin: 0; }
.hub-grid .tag { align-self: start; white-space: normal; }
.hub-grid dl { margin: 0; font-size: .88rem; }
.hub-grid dt { font-weight: 700; margin-top: .5rem; }
.hub-grid dd { margin: .25rem 0 .6rem; line-height: 1.65; }
.hub-grid a { margin-top: auto; }
.hub-matrix { font-variant-numeric: tabular-nums; }
.hub-matrix caption { text-align: left; margin-block: .8rem; }
.hub-controls { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: 1rem; }
.hub-controls[hidden], figure[hidden] { display: none; }
.hub-controls button { border: 1px solid currentColor; border-radius: .5rem; padding: .5rem .8rem; background: transparent; color: inherit; cursor: pointer; }
.hub-controls button[aria-pressed="true"] { color: var(--paper); background: var(--accent-strong); border-color: var(--accent-strong); }
figure { margin: 1.5rem 0; }
figcaption { font-weight: 700; margin-bottom: 1rem; }
.hub-bars { display: grid; gap: 1rem; }
.hub-bar-row { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 5.5rem; gap: .7rem; align-items: center; font-variant-numeric: tabular-nums; }
.hub-bar-row strong { text-align: right; }
.hub-bar-track { border-left: 1px solid currentColor; padding-block: .15rem; }
.hub-bar { display: block; height: 1.1rem; background: var(--accent-strong); border-radius: 0 .2rem .2rem 0; }
.loss .hub-bar { background: var(--ink-soft); }
.hub-revisions { padding-left: 1.4rem; }
.hub-revisions li { padding-left: .5rem; margin-block: 1.2rem; }
.hub-revisions h3 { margin-bottom: .3rem; font-size: 1rem; }
@media (max-width: 800px) { .hub-section { scroll-margin-top: 1rem; } }
@media (max-width: 680px) { .hub-grid { grid-template-columns: 1fr; } .hub-bar-row { grid-template-columns: 4rem minmax(0, 1fr) 4.6rem; gap: .4rem; font-size: .85rem; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-metric-explorer]').forEach(explorer => {
    const controls = explorer.querySelector<HTMLElement>('[data-metric-controls]');
    if (!controls) return;
    controls.hidden = false;
    const select = (id: string) => {
      explorer.querySelectorAll<HTMLElement>('[data-metric-panel]').forEach(panel => { panel.hidden = panel.dataset.metricPanel !== id; });
      explorer.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach(button => { button.setAttribute('aria-pressed', String(button.dataset.metric === id)); });
    };
    controls.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-metric]');
      if (button?.dataset.metric) select(button.dataset.metric);
    });
    select('return');
  });
</script>

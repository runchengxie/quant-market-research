---
import { microcapHistory, historyCopy } from '../../content/microcap-history';
import { recoveryCopy, recoveryRecords } from '../../content/microcap-recovery';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="microcap-coverage" class="panel history-register">
  <h2 data-locale-text data-en={historyCopy.heading[0]} data-zh={historyCopy.heading[1]}>{historyCopy.heading[0]}</h2>
  <p data-locale-text data-en={historyCopy.intro[0]} data-zh={historyCopy.intro[1]}>{historyCopy.intro[0]}</p>
  <p data-locale-text data-en={historyCopy.scope[0]} data-zh={historyCopy.scope[1]}>{historyCopy.scope[0]}</p>
  <a href={`${base}/research/microcap/report/`} data-locale-text data-en={historyCopy.action[0]} data-zh={historyCopy.action[1]}>{historyCopy.action[0]}</a>
  <div class="history-items">
    {microcapHistory.map(record=><details id={`history-${record.id}`}>
      <summary><span>{record.id} · </span><span data-locale-text data-en={record.title[0]} data-zh={record.title[1]}>{record.title[0]}</span></summary>
      <p class="history-status"><strong data-locale-text data-en={record.status[0]} data-zh={record.status[1]}>{record.status[0]}</strong> · <span data-locale-text data-en={record.scope[0]} data-zh={record.scope[1]}>{record.scope[0]}</span></p>
      <p data-locale-text data-en={record.finding[0]} data-zh={record.finding[1]}>{record.finding[0]}</p>
      <p data-locale-text data-en={record.boundary[0]} data-zh={record.boundary[1]}>{record.boundary[0]}</p>
    </details>)}
  </div>
</section>
<section id="microcap-evidence-recovery" class="panel history-register">
  <h2 data-locale-text data-en={recoveryCopy.title[0]} data-zh={recoveryCopy.title[1]}>{recoveryCopy.title[0]}</h2>
  <p data-locale-text data-en={recoveryCopy.intro[0]} data-zh={recoveryCopy.intro[1]}>{recoveryCopy.intro[0]}</p>
  <p data-locale-text data-en={recoveryCopy.scope[0]} data-zh={recoveryCopy.scope[1]}>{recoveryCopy.scope[0]}</p>
  <div class="history-items">
    {recoveryRecords.map(record=><details id={`recovery-${record.id}`}>
      <summary><span>{record.id} · </span><span data-locale-text data-en={record.title[0]} data-zh={record.title[1]}>{record.title[0]}</span></summary>
      <p><strong data-locale-text data-en={record.status[0]} data-zh={record.status[1]}>{record.status[0]}</strong></p>
      <p data-locale-text data-en={record.finding[0]} data-zh={record.finding[1]}>{record.finding[0]}</p>
      <p data-locale-text data-en={record.boundary[0]} data-zh={record.boundary[1]}>{record.boundary[0]}</p>
    </details>)}
  </div>
</section>
<style>
.history-register{margin-block:1.5rem}.history-items{margin-top:1rem}.history-items details{border-top:1px solid var(--rule);padding:0.8rem 0}.history-items summary{cursor:pointer;color:var(--ink);font-weight:600}.history-items p{max-width:88ch;line-height:1.8;color:var(--ink)}.history-status{font-size:0.9rem;color:var(--ink-soft)}
</style>

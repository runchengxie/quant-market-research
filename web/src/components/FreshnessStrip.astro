---
interface Props {
  snapshot: { generated_at?: string; as_of?: string; coverage_start?: string; coverage_end?: string; source?: string; quality_status?: string; markets?: Record<string, { as_of?: string | null }> };
  label?: string;
  snapshotKey?: string;
}
import { englishSnapshotSource } from "../lib/data-catalog";
import { freshnessStatusCopy, freshnessSourceCopy } from "../content/freshness-copy";
const { snapshot, label = "数据新鲜度", snapshotKey = "" } = Astro.props;
const dateEn = (value?: string | null) => value ? value.slice(0, 10) : "Date pending";
const dateZh = (value?: string | null) => value ? value.slice(0, 10) : "日期待补";
const rangeEn = snapshot.coverage_start && snapshot.coverage_end
  ? `${snapshot.coverage_start} to ${snapshot.coverage_end}`
  : `As of ${dateEn(snapshot.as_of ?? snapshot.coverage_end)}`;
const rangeZh = snapshot.coverage_start && snapshot.coverage_end
  ? `${snapshot.coverage_start} 至 ${snapshot.coverage_end}`
  : `截至 ${dateZh(snapshot.as_of ?? snapshot.coverage_end)}`;
const status = snapshot.quality_status ?? "pending";
const statusCopy = freshnessStatusCopy[status] ?? [status, status];
const sourceCopy = freshnessSourceCopy[snapshotKey] ?? [englishSnapshotSource(snapshotKey, snapshot.source ?? "pending"), snapshot.source ?? "待补"];
const marketDatesEn = Object.entries(snapshot.markets ?? {}).map(([market, value]) => `${market} ${dateEn(value.as_of)}`).join(" · ");
const marketDatesZh = Object.entries(snapshot.markets ?? {}).map(([market, value]) => `${market} ${dateZh(value.as_of)}`).join(" · ");
---

<aside class={`freshness-strip status-${status}`} aria-label="Data freshness">
  <span class="section-kicker" data-locale-text data-en="Data freshness" data-zh={label}>Data freshness</span>
  <strong data-locale-text data-en={rangeEn} data-zh={rangeZh}>{rangeEn}</strong>
  <span class="freshness-status" data-locale-text data-en={statusCopy[0]} data-zh={statusCopy[1]}>{statusCopy[0]}</span>
  <span class="freshness-source" data-locale-text data-en={`Source: ${sourceCopy[0]}; snapshot generated ${dateEn(snapshot.generated_at)}`} data-zh={`来源：${sourceCopy[1]}；快照生成于 ${dateZh(snapshot.generated_at)}`}>Source: {sourceCopy[0]}; snapshot generated {dateEn(snapshot.generated_at)}</span>
  {marketDatesEn && <span class="freshness-markets" data-locale-text data-en={`Markets: ${marketDatesEn}`} data-zh={`各市场：${marketDatesZh}`}>Markets: {marketDatesEn}</span>}
</aside>

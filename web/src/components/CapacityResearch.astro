---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopicNav from './TopicNav.astro';
import { LiquidityPage } from './react/liquidity-page';
import ExecutionReport from './ExecutionReport.astro';
import LiquidityRebuildEvidence from './LiquidityRebuildEvidence.astro';
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
const rebuilt=JSON.parse(await readFile(resolve(process.cwd(),'public/data/liquidity/summary.json'),'utf8'));
const commonDate=rebuilt.periods?.find((p:any)=>p.period==='common snapshot')?.common_end??'';
const verdict=c.rebuiltVerdict.map(value=>value.replace('{date}',commonDate));
import {liquidityExitCopy as exitCopy} from '../content/liquidity-exit-copy';
import {liquidityStressCopy as stressCopy} from '../content/liquidity-stress-copy';
import { liquidityResearchCopy as c } from '../content/liquidity-research-copy';
import { withBase } from '../lib/routes';
const sections = [
 ['market-profiles',c.explorer],['liquidity-stress',stressCopy.title],['liquidity-exit',exitCopy.title],['liquidity-universe-sensitivity',c.universeTitle],['liquidity-quality',c.quality],['capacity-data-coverage',c.coverageTitle],['liquidity-evidence',c.evidenceTitle],['order-budget',c.budget],
 ['expanded-results',['Static costs','静态交易成本']],['strategy-diagnostic',['Strategy scenarios','策略情景']],
 ['minute-execution',['Minute execution','分钟执行']],['research-notes',c.notes],
].map(([id,label])=>({id:id as string,label:label[1],labelEn:label[0],available:true}));
const notes = [
 ['2026-10-18','Frozen-name exit budgets and revision baseline','固定名单退出预算与版本基线','Per-stock budget coverage follows fixed 2024–2025 month-end groups with a conservative sell sensitivity. A continuous-month minute probe and exact feature revision gate retain unresolved evidence.','固定2024—2025年月末名单，逐只研究预算覆盖及保守卖出约束；连续月份分钟探针和逐行版本回归检查保留未知证据。','docs/research/experiments/liquidity-exit-20261018'],
 ['2026-10-18','Stress months, frozen cohorts and recorded clock windows','低成交月份、冻结名单与记录时刻窗口','Within-year low-turnover months are compared with other months; month-end groups are followed for 20 observations. A 15-date minute sample adds window-share sensitivity with stock-day qualification gates.','比较同年低成交月份与其余月份，冻结月末名单跟踪20个观察日；15个选定分钟日期在证券日筛选后提供窗口占比敏感性。','docs/research/experiments/liquidity-stress-20261018'],
 ['2026-10-18','SH/SZ scope and lifecycle sensitivity','沪深范围与生命周期敏感性','SH/SZ-only results replace the mixed BSE daily aggregates. Lifecycle cross-checks leave tested observations unchanged, while daily minimum stock counts constrain turnover-budget ranges.','沪深限定结果替换混入北交所的日线汇总。生命周期核对未改变被测观测；预算情景新增区间，并受每日最小股票数约束。','docs/research/experiments/liquidity-universe-20261018'],
 ['2026-10-16','Daily, minute and Level 2 coverage audit','日线、分钟与 Level 2 覆盖审计','A-share 1-minute turnover now reconciles to daily turnover over the published history. Aggregate totals are close, with residual stock-day discrepancies and selected-date L2 limits disclosed.','已对发布范围内的 A 股 1 分钟成交额与日线成交额进行核对。全市场总额接近，但仍有证券日差异；Level 2 的选日样本限制也已单列。','docs/research/experiments/capacity-data-quality-20261016'],
 ['2026-10-16','Empty buckets and relative size','空桶与相对市值分组','Market coverage remains visible when a size bucket is empty. Daily within-market quintiles add a separate relative comparison.','市值桶为空时仍显示市场覆盖；每日市场内部五等分提供另一种相对比较。','docs/research/experiments/liquidity-size-groups-20261016'],
 ['2026-10-16','Four-market recomputation and source audit','四市场复算与来源核查','Common-date and historical summaries now use explicit lagged means/medians and prior FX. Sparse US source dates are isolated; Japanese shares remain exploratory.','共同日期与历史汇总已明确区分滞后均值、中位数和历史汇率；稀疏美股日期已隔离，日股股数仍为探索性来源。','docs/research/experiments/liquidity-rebuild-20261016'],
 ['2026-10-17','Distribution tails and minute/daily follow-up','分布尾部与分钟/日线补充核查','Turnover distributions now expose P10/P25/P50/P75/P90 and observed zero-ADV20 shares. Targeted reconciliation isolates Beijing-exchange discrepancies but cannot establish their cause or a full-universe zero-trade rate.','成交额分布新增 P10/P25/P50/P75/P90 及已纳入样本中的零 ADV20 占比。定向对账发现北京市场差异较集中，但不能据此确认原因或完整股票池的零成交率。','docs/research/experiments/liquidity-followups-20261017'],
 ['2026-10-16','Count and metric audit','数量与指标审计','Archived inherited release: conflicting A-share counts remain unverified. Recomputed results are maintained separately.','历史发布已归档：A股冲突数量仍无法追溯确认，重新计算的结果另行维护。','docs/research/experiments/liquidity-capacity-audit-20261016'],
 ['2026-10-12','Three-day static pilot','三日静态探索','Measured spread and ten-level depth; costs are conditional on full coverage.','测量价差与十档深度，成本分位数以完整覆盖为条件。','studies/ashare_execution_costs/pilot_findings'],
 ['2026-10-12','Ten-date expansion','十日扩展','311,395 sampled snapshots; 306,483 valid and 4,912 excluded. Selected dates do not establish population estimates.','抽样快照311,395条，其中有效306,483条、剔除4,912条；选定日期不能代表全市场总体。','docs/research/experiments/execution-cost-expansion-20261012'],
 ['2026-10-12','Data fitness and corrected replay','数据可用性与回放修正','Same-date paths were corrected. Vendor semantics and cross-stream ordering remain unverified.','已修正混入异日快照的路径，供应商事件语义和跨流顺序仍待核验。','docs/studies/execution-data-fitness-20261012'],
] as const;
---
<SiteLayout title={c.title[1]} titleEn={c.title[0]} description={c.lead[0]} section="research" activeRoute="liquidity">
<article class="capacity-research">
<header class="theme-heading"><div><span class="section-kicker" data-locale-text data-en="Cross-market liquidity" data-zh="跨市场流动性">Cross-market liquidity</span><h1 data-locale-text data-en={c.title[0]} data-zh={c.title[1]}>{c.title[0]}</h1><p data-locale-text data-en={c.lead[0]} data-zh={c.lead[1]}>{c.lead[0]}</p></div></header>
<section class="research-verdict"><span class="evidence-status" data-locale-text data-en="Recomputed descriptive evidence · execution remains uncalibrated" data-zh="已复算的描述性证据 · 真实执行未校准">Recomputed descriptive evidence · execution remains uncalibrated</span><p data-locale-text data-en={verdict[0]} data-zh={verdict[1]}>{verdict[0]}</p></section>
<TopicNav sections={sections}/>
<LiquidityPage client:only="react"><p slot="fallback" class="loading" data-locale-text data-en="Loading research data…" data-zh="正在加载研究数据……">Loading research data…</p></LiquidityPage>
<LiquidityRebuildEvidence/>
<ExecutionReport embedded/>
<section id="research-notes" class="research-notes report-section"><h2 data-locale-text data-en={c.notes[0]} data-zh={c.notes[1]}>{c.notes[0]}</h2>
{notes.map(([date,en,zh,enNote,zhNote,path])=><details><summary><time>{date}</time> · <span data-locale-text data-en={en} data-zh={zh}>{en}</span></summary><p data-locale-text data-en={enNote} data-zh={zhNote}>{enNote}</p><a href={`https://github.com/runchengxie/quant-market-research/blob/main/${path}.md`} data-locale-link data-href-en={`https://github.com/runchengxie/quant-market-research/blob/main/${path}.md`} data-href-zh={`https://github.com/runchengxie/quant-market-research/blob/main/${path}.zh-CN.md`} data-locale-text data-en="Read methods and evidence ↗" data-zh="查看方法与证据 ↗">Read methods and evidence ↗</a></details>)}
<h3 data-locale-text data-en={c.next[0]} data-zh={c.next[1]}>{c.next[0]}</h3><p data-locale-text data-en={c.nextText[0]} data-zh={c.nextText[1]}>{c.nextText[0]}</p>
<p class="report-links"><a href={withBase('/research/microcap/',import.meta.env.BASE_URL)} data-locale-text data-en="Related micro-cap research →" data-zh="关联小微盘研究 →">Related micro-cap research →</a></p>
</section>
</article></SiteLayout>

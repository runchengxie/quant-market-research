---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopicNav from './TopicNav.astro';
import { LiquidityPage } from './react/liquidity-page';
import ExecutionReport from './ExecutionReport.astro';
import { liquidityResearchCopy as c } from '../content/liquidity-research-copy';
import { withBase } from '../lib/routes';
const sections = [
 ['market-profiles',c.explorer],['liquidity-quality',c.quality],['order-budget',c.budget],
 ['expanded-results',['Static costs','静态交易成本']],['strategy-diagnostic',['Strategy scenarios','策略情景']],
 ['minute-execution',['Minute execution','分钟执行']],['research-notes',c.notes],
].map(([id,label])=>({id:id as string,label:label[1],labelEn:label[0],available:true}));
const notes = [
 ['2026-10-16','Count and metric audit','数量与指标审计','Conflicting A-share counts are excluded; missing P90 stays missing. Cross-market dates and mean/median lineage remain unresolved.','A股数量冲突已隔离，缺失P90保持缺失。跨市场日期及均值、中位数生成来源仍待核验。','docs/research/experiments/liquidity-capacity-audit-20261016'],
 ['2026-10-12','Three-day static pilot','三日静态探索','Measured spread and ten-level depth; costs are conditional on full coverage.','测量价差与十档深度，成本分位数以完整覆盖为条件。','studies/ashare_execution_costs/pilot_findings'],
 ['2026-10-12','Ten-date expansion','十日扩展','311,395 sampled snapshots; 306,483 valid and 4,912 excluded. Selected dates do not establish population estimates.','抽样快照311,395条，其中有效306,483条、剔除4,912条；选定日期不能代表全市场总体。','docs/research/experiments/execution-cost-expansion-20261012'],
 ['2026-10-12','Data fitness and corrected replay','数据可用性与回放修正','Same-date paths were corrected. Vendor semantics and cross-stream ordering remain unverified.','已修正混入异日快照的路径，供应商事件语义和跨流顺序仍待核验。','docs/studies/execution-data-fitness-20261012'],
] as const;
---
<SiteLayout title={c.title[1]} titleEn={c.title[0]} description={c.lead[0]} section="research" activeRoute="liquidity">
<article class="capacity-research">
<header class="theme-heading"><div><span class="section-kicker" data-locale-text data-en="Cross-market liquidity" data-zh="跨市场流动性">Cross-market liquidity</span><h1 data-locale-text data-en={c.title[0]} data-zh={c.title[1]}>{c.title[0]}</h1><p data-locale-text data-en={c.lead[0]} data-zh={c.lead[1]}>{c.lead[0]}</p></div></header>
<section class="research-verdict"><span class="evidence-status" data-locale-text data-en="Historical profiles · static measurement · modeled execution" data-zh="历史画像 · 静态测量 · 执行模拟">Historical profiles · static measurement · modeled execution</span><p data-locale-text data-en="A-share historical profile counts conflict and are excluded from comparisons. The ten-date L2 study remains descriptive: at CNY 1m, full ten-level coverage is 62.12% for buys and 67.68% for sells. Real execution remains uncalibrated." data-zh="A股历史流动性画像数量不一致，已排除出对比。十日L2研究仍属于描述性测量：100万元订单的十档完整覆盖率为买入62.12%、卖出67.68%。真实执行尚未完成校准。">A-share historical profile counts conflict and are excluded from comparisons. The ten-date L2 study remains descriptive: at CNY 1m, full ten-level coverage is 62.12% for buys and 67.68% for sells. Real execution remains uncalibrated.</p></section>
<TopicNav sections={sections}/>
<LiquidityPage client:only="react"><p slot="fallback" class="loading" data-locale-text data-en="Loading research data…" data-zh="正在加载研究数据……">Loading research data…</p></LiquidityPage>
<ExecutionReport embedded/>
<section id="research-notes" class="research-notes report-section"><h2 data-locale-text data-en={c.notes[0]} data-zh={c.notes[1]}>{c.notes[0]}</h2>
{notes.map(([date,en,zh,enNote,zhNote,path])=><details><summary><time>{date}</time> · <span data-locale-text data-en={en} data-zh={zh}>{en}</span></summary><p data-locale-text data-en={enNote} data-zh={zhNote}>{enNote}</p><a href={`https://github.com/runchengxie/quant-market-research/blob/main/${path}.md`} data-locale-link data-href-en={`https://github.com/runchengxie/quant-market-research/blob/main/${path}.md`} data-href-zh={`https://github.com/runchengxie/quant-market-research/blob/main/${path}.zh-CN.md`} data-locale-text data-en="Read methods and evidence ↗" data-zh="查看方法与证据 ↗">Read methods and evidence ↗</a></details>)}
<h3 data-locale-text data-en={c.next[0]} data-zh={c.next[1]}>{c.next[0]}</h3><p data-locale-text data-en={c.nextText[0]} data-zh={c.nextText[1]}>{c.nextText[0]}</p>
<p class="report-links"><a href={withBase('/research/microcap/',import.meta.env.BASE_URL)} data-locale-text data-en="Related micro-cap research →" data-zh="关联小微盘研究 →">Related micro-cap research →</a></p>
</section>
</article></SiteLayout>

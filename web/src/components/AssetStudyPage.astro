---
import SiteLayout from '../layouts/SiteLayout.astro';
import T from './LocaleText.astro';
import AssetTopicLinks from './AssetTopicLinks.astro';
import {assetTopics,assetReadingCopy as c,type AssetTopicId} from '../content/asset-topics';
import {assetTopicContents} from '../content/asset-topics';
import {assetEvidenceVersion} from '../content/asset-publication.server';
import AssetEvidenceVersion from './AssetEvidenceVersion.astro';
const {topic}=Astro.props as {topic:AssetTopicId};
const study=assetTopics.find(t=>t.id===topic)!;
---
<SiteLayout title={study.title[1]} titleEn={study.title[0]} description={study.intro[1]} section="research">
<article class="asset-study">
<header class="asset-introduction"><T text={c.directory} as="span"/><h1><T text={study.title} as="span"/></h1><T text={study.intro}/><h2><T text={c.current} as="span"/></h2><T text={study.finding}/><dl><dt><T text={c.sample} as="span"/></dt><dd><T text={study.sample}/></dd><dt><T text={c.limits} as="span"/></dt><dd><T text={study.limit}/></dd><dt><T text={c.versionDate} as="span"/></dt><dd><time datetime={assetEvidenceVersion.date} data-evidence-version-date>{assetEvidenceVersion.date}</time> · <a href="#asset-evidence-version"><T text={c.versionRecord} as="span"/></a></dd></dl></header>
<AssetTopicLinks current={topic}/>
<nav class="asset-page-contents" aria-label={c.contents[0]} data-locale-aria data-aria-en={c.contents[0]} data-aria-zh={c.contents[1]}><h2><T text={c.contents} as="span"/></h2><ul>{assetTopicContents[topic].map(entry=><li><a href={`#${entry.id}`}><T text={entry.label} as="span"/></a></li>)}</ul></nav>
<section class="reading-basics"><T text={topic==='returns'?c.returnBasics:topic==='allocation'?c.allocationBasics:c.implementationBasics}/>{topic==='returns'&&<T text={c.annualMeaning}/>}{topic==='allocation'&&<T text={c.spendingBasics}/>}</section>
<slot/>
<AssetEvidenceVersion version={assetEvidenceVersion} id="asset-evidence-version" heading="h2"/>
<section class="asset-next"><h2><T text={c.next} as="span"/></h2><AssetTopicLinks current={topic}/></section>
</article>
</SiteLayout>
<style>
.asset-study{max-width:1100px;margin-inline:auto;min-width:0}.asset-study :global(p){max-width:72ch;line-height:1.85}.asset-study :global(h1){max-width:24ch}.asset-study :global(h2){margin-block:2rem .8rem}.asset-study :global(h3){margin-top:2rem}.asset-study :global(h4){margin-top:1.5rem}.asset-study :global([id]){scroll-margin-top:12rem}.asset-introduction{padding-block:1rem}.asset-introduction dl{max-width:76ch;margin-top:1.5rem}.asset-introduction dt{font-size:.9rem;color:var(--muted);margin-top:1rem}.asset-introduction dd{margin:0}.asset-page-contents ul{padding-left:1.25rem;line-height:1.9}.reading-basics{border-left:2px solid var(--accent);padding-left:1rem;margin-block:1.5rem}.asset-study :global(.panel){padding:1.25rem 0;border:0;background:transparent}.asset-study :global(details){margin-block:1.1rem}.asset-study :global(summary){padding-block:.5rem}.asset-study :global(table){font-size:.94rem}.asset-next{margin-top:2rem;border-top:1px solid var(--rule)}@media(max-width:480px){.asset-study :global(table){font-size:.86rem}.asset-study :global([id]){scroll-margin-top:8rem}}
</style>

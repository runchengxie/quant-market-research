---
import type { Copy } from '../content/rotation-research';
interface Props { text: Copy; as?: 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'span' | 'strong' | 'summary'; class?: string; id?:string }
const { text, as: Tag = 'p', class: className, id }: Props = Astro.props;
---
<Tag id={id} class={className} data-locale-text data-en={text[0]} data-zh={text[1]}>{text[0]}</Tag>

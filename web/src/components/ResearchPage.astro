---
import SiteLayout from "../layouts/SiteLayout.astro";
import FreshnessStrip from "./FreshnessStrip.astro";
import ResearchContext from "./research/ResearchContext.astro";
import { conclusionCopy } from "../conclusion-copy";
import TopicNav from "./TopicNav.astro";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

interface Props {
  title: string;
  titleEn?: string;
  description: string;
  snapshotKey: "cashflow" | "microcap" | "barra" | "indices" | "liquidity";
  activeRoute: string;
  kicker: string;
  kickerEn?: string;
  introduction: string;
  introductionEn?: string;
  boundary: string;
  boundaryEn?: string;
  evidence?: string;
  evidenceEn?: string;
  question?: string;
  questionEn?: string;
  nextStep?: string;
  nextStepEn?: string;
  compact?: boolean;
  sections?: readonly { id: string; label: string; available: boolean }[];
}

const { title, titleEn = title, description, snapshotKey, activeRoute, kicker, kickerEn = kicker, introduction, introductionEn = introduction, boundary, boundaryEn = boundary, evidence = "描述性研究", evidenceEn = evidence, question = "这项研究正在回答什么问题？", questionEn = question, nextStep = "补充数据核验和可执行性测试。", nextStepEn = nextStep, compact = false, sections } = Astro.props;
const topicSections = sections ?? [{ id: "topic-content", label: "研究内容", available: true }, { id: "research-method", label: "数据与方法", available: true }];
const manifest = JSON.parse(await readFile(resolve(process.cwd(), "public/data/manifest.json"), "utf8"));
const snapshot = manifest.snapshots?.[snapshotKey] ?? {};
---

<SiteLayout title={title} titleEn={titleEn} description={description} activeRoute={activeRoute} workbench={compact}>
  <section class="theme-heading">
    <div>
      <span class="section-kicker" data-locale-text data-en={kickerEn} data-zh={kicker}>{kickerEn}</span>
      <h1 data-locale-text data-en={titleEn} data-zh={title}>{titleEn}</h1>
      <p data-locale-text data-en={compact ? conclusionCopy.byTopic[snapshotKey].en : introductionEn} data-zh={compact ? conclusionCopy.byTopic[snapshotKey].zh : introduction}>{compact ? conclusionCopy.byTopic[snapshotKey].en : introductionEn}</p>
    </div>
  </section>
  {!compact && <section class="research-verdict" aria-labelledby="current-conclusion">
    <h2 id="current-conclusion" data-locale-text data-en={conclusionCopy.heading.en} data-zh={conclusionCopy.heading.zh}>{conclusionCopy.heading.en}</h2>
    <span class="evidence-status" data-locale-text data-en={evidenceEn} data-zh={evidence}>{evidenceEn}</span>
    <p data-locale-text data-en={conclusionCopy.byTopic[snapshotKey].en} data-zh={conclusionCopy.byTopic[snapshotKey].zh}>{conclusionCopy.byTopic[snapshotKey].en}</p>
    <p><strong data-locale-text data-en={conclusionCopy.boundary.en} data-zh={conclusionCopy.boundary.zh}>{conclusionCopy.boundary.en}</strong> · <span data-locale-text data-en={boundaryEn} data-zh={boundary}>{boundaryEn}</span></p>
    <small>{snapshot.coverage_start ?? '—'} — {snapshot.coverage_end ?? '—'}</small>
  </section>}
  <TopicNav sections={topicSections} />
  {compact && <>
    <div class="workbench-meta"><span data-locale-text data-en="Historical sample" data-zh="历史样本">Historical sample</span><strong>{snapshot.coverage_start ?? "Date pending"} — {snapshot.coverage_end ?? "Date pending"}</strong><span class="evidence-status" data-locale-text data-en={evidenceEn} data-zh={evidence}>{evidenceEn}</span></div>
    <p class="workbench-boundary" data-locale-text data-en={boundaryEn} data-zh={boundary}>{boundaryEn}</p>
  </>}
  <div id="topic-content"><slot /></div>
  {<details id="research-method" class="panel research-source"><summary data-locale-text data-en="Sources, dates, and research progress" data-zh="数据来源、更新日期与研究进展">Sources, dates, and research progress</summary><FreshnessStrip snapshot={snapshot} snapshotKey={snapshotKey} /><ResearchContext question={question} questionEn={questionEn} evidence={evidence} evidenceEn={evidenceEn} nextStep={nextStep} nextStepEn={nextStepEn} /></details>}
</SiteLayout>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import FreshnessStrip from "./FreshnessStrip.astro";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

interface Props {
  title: string;
  description: string;
  snapshotKey: "cashflow" | "microcap" | "barra" | "indices" | "liquidity";
  activeRoute: string;
  kicker: string;
  introduction: string;
  boundary: string;
  evidence?: string;
  question?: string;
  nextStep?: string;
}

const { title, description, snapshotKey, activeRoute, kicker, introduction, boundary, evidence = "描述性研究", question = "这项研究正在回答什么问题？", nextStep = "补充数据核验和可执行性测试。" } = Astro.props;
const manifest = JSON.parse(await readFile(resolve(process.cwd(), "public/data/manifest.json"), "utf8"));
---

<SiteLayout title={title} description={description} activeRoute={activeRoute}>
  <section class="theme-heading">
    <div>
      <span class="section-kicker">{kicker}</span>
      <h2>{title}</h2>
      <p>{introduction}</p>
    </div>
  </section>
  <p class="fine-print"><span class="section-kicker">阅读边界</span><br />{boundary}</p>
  <FreshnessStrip snapshot={manifest.snapshots?.[snapshotKey] ?? {}} />
  <section class="report-context" aria-label="研究摘要">
    <div><span class="section-kicker">研究问题</span><p>{question}</p></div>
    <div><span class="section-kicker">证据状态</span><p><span class="evidence-status">{evidence}</span></p></div>
    <div><span class="section-kicker">下一步</span><p>{nextStep}</p></div>
  </section>
  <slot />
</SiteLayout>

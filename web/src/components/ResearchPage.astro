---
import SiteLayout from "../layouts/SiteLayout.astro";
import FreshnessStrip from "./FreshnessStrip.astro";
import ResearchContext from "./research/ResearchContext.astro";
import TopicNav from "./TopicNav.astro";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

interface Props {
  title: string;
  description: string;
  snapshotKey: "cashflow" | "microcap" | "barra" | "indices" | "liquidity";
  activeRoute: string;
  kicker: string;
  introduction: string;
  boundary: string;
  evidence?: string;
  question?: string;
  nextStep?: string;
  compact?: boolean;
  sections?: readonly { id: string; label: string; available: boolean }[];
}

const { title, description, snapshotKey, activeRoute, kicker, introduction, boundary, evidence = "描述性研究", question = "这项研究正在回答什么问题？", nextStep = "补充数据核验和可执行性测试。", compact = false, sections } = Astro.props;
const topicSections = sections ?? [{ id: "topic-content", label: "研究内容", available: true }, { id: "research-method", label: "数据与方法", available: true }];
const manifest = JSON.parse(await readFile(resolve(process.cwd(), "public/data/manifest.json"), "utf8"));
const snapshot = manifest.snapshots?.[snapshotKey] ?? {};
---

<SiteLayout title={title} description={description} activeRoute={activeRoute} workbench={compact}>
  <section class="theme-heading">
    <div>
      <span class="section-kicker">{kicker}</span>
      <h1>{title}</h1>
      <p>{introduction}</p>
    </div>
  </section>
  <TopicNav sections={topicSections} />
  {compact ? <>
    <div class="workbench-meta"><span>历史样本</span><strong>{snapshot.coverage_start ?? "日期待补"} — {snapshot.coverage_end ?? "日期待补"}</strong><span class="evidence-status">{evidence}</span></div>
    <p class="workbench-boundary">{boundary}</p>
  </> : <>
    <p class="fine-print"><span class="section-kicker">阅读边界</span><br />{boundary}</p>
    <div id="research-method"><FreshnessStrip snapshot={snapshot} /><ResearchContext question={question} evidence={evidence} nextStep={nextStep} /></div>
  </>}
  <div id="topic-content"><slot /></div>
  {compact && <details id="research-method" class="panel research-source"><summary>数据来源、更新日期与研究进展</summary><FreshnessStrip snapshot={snapshot} /><ResearchContext question={question} evidence={evidence} nextStep={nextStep} /></details>}
</SiteLayout>

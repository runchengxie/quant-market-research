---
import { readingSummaries, readingCopy as c } from '../content/research-reading.server';
import { publicPages } from '../content/public-registry';
import { englishCopy } from '../content/locale-copy';
import T from './LocaleText.astro';
import { withBase } from '../lib/routes';
const { compact = false } = Astro.props;
const base=import.meta.env.BASE_URL;
---
<div class:list={['research-grid','directory-grid',{'home-directory':compact}]}>
{readingSummaries.map(r=><article class="research-card reading-card" data-research-id={r.id}>
  <span class="research-stage"><T as="span" text={c[r.stage]}/></span>
  <h2><a href={withBase(r.route,base)}><T as="span" text={r.title}/></a></h2>
  <p class="reading-conclusion"><T as="span" text={r.conclusion}/></p>
  <dl><dt><T as="span" text={c.coverage}/></dt><dd><T as="span" text={r.coverage}/></dd>
  <dt><T as="span" text={c.scope}/></dt><dd><T as="span" text={r.scope}/></dd>
  <dt><T as="span" text={c.limit}/></dt><dd><T as="span" text={r.limit}/></dd></dl>
  {!compact && <details><summary><T as="span" text={c.archive}/></summary><ul>{r.related.map(id=>{const p=publicPages.find(p=>p.id===id);return p&&<li><a href={withBase(p.route,base)}><T as="span" text={[englishCopy(p).title,p.title]}/></a></li>})}<li><a href={withBase(`/data-sources/#research-${r.id}`,base)}><T as="span" text={c.sources}/></a></li></ul></details>}
</article>)}
</div>

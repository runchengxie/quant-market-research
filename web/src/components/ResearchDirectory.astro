---
import { readingSummaries, readingCopy as c } from '../content/research-reading.server';
import { libraryGroups, libraryCopy as l, librarySummaries } from '../content/research-library';
import { publicPages } from '../content/public-registry';
import { englishCopy } from '../content/locale-copy';
import T from './LocaleText.astro';
import { withBase } from '../lib/routes';
const base=import.meta.env.BASE_URL;
---
<nav class="library-nav" aria-label="Research areas" data-locale-aria data-aria-en="Research areas" data-aria-zh="研究方向">
  {libraryGroups.map((group,index)=><a href={'#area-'+group.id}><span class="library-nav-number">0{index+1}</span><T as="span" text={group.title}/><span class="library-nav-count">{group.topics.length}</span></a>)}
</nav>
<div class="research-library">
{libraryGroups.map((group,index)=><section class="library-group" id={'area-'+group.id} aria-labelledby={'heading-'+group.id}>
  <div class="library-group-heading"><span class="library-group-number">0{index+1}</span><div><h2 id={'heading-'+group.id}><T as="span" text={group.title}/></h2><T text={group.description}/></div></div>
  <div class="research-grid directory-grid">
  {group.topics.map(id=>readingSummaries.find(r=>r.id===id)!).map(r=><article class="research-card reading-card" data-research-id={r.id}>
    <span class:list={['research-stage','stage-'+r.stage]}><T as="span" text={c[r.stage]}/></span>
    <h3><a href={withBase(r.route,base)}><T as="span" text={r.title}/></a></h3>
    <T class="reading-conclusion" text={librarySummaries[r.id]}/>
    <dl class="reading-sample"><dt><T as="span" text={c.coverage}/></dt><dd><T as="span" text={r.coverage}/></dd></dl>
    <div class="reading-limit"><T as="strong" text={c.limit}/><T text={r.limit}/></div>
    <a class="library-open" href={withBase(r.route,base)}><T as="span" text={l.open}/></a>
    <details><summary><T as="span" text={c.archive}/></summary><T as="strong" text={l.detail}/><T text={r.conclusion}/>
      <dl><dt><T as="span" text={c.scope}/></dt><dd><T as="span" text={r.scope}/></dd></dl>
      <ul>{r.related.map(id=>{const p=publicPages.find(p=>p.id===id);return p&&<li><a href={withBase(p.route,base)}><T as="span" text={[englishCopy(p).title,p.title]}/></a></li>})}<li><a href={withBase('/data-sources/#research-'+r.id,base)}><T as="span" text={c.sources}/></a></li></ul>
    </details>
  </article>)}
  </div>
</section>)}
</div>

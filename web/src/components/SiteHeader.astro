---
import ThemeToggle from "./react/ThemeToggle";
import { withBase } from "../lib/routes";

interface Props { activeRoute: string }

const { activeRoute } = Astro.props;
const links = [
  { id: "overview", label: "研究总览", href: "/" },
  { id: "cashflow", label: "现金流", href: "/research/cashflow/" },
  { id: "microcap", label: "微盘股", href: "/research/microcap/" },
  { id: "style", label: "指数与风格", href: "/research/indices/" },
  { id: "low-turnover", label: "低换手", href: "/research/factors/low-turnover/" },
  { id: "liquidity", label: "流动性", href: "/research/liquidity/" },
];
---

<header class="site-header">
  <div class="site-masthead">
    <div>
      <span class="brand-kicker">历史市场研究 · 证据优先</span>
      <h1>市场研究档案</h1>
      <p class="site-deck">汇集历史市场研究，标明数据日期、研究进展和使用限制。</p>
    </div>
    <div class="site-meta">
      <span>公开研究 · 数据日期见下方</span>
      <strong>汇总结果 · 仅描述历史</strong>
      <ThemeToggle client:load />
    </div>
  </div>
  <nav class="site-nav" aria-label="研究主题">
    {links.map((link) => <a class:list={{ active: activeRoute === link.id }} href={withBase(link.href, import.meta.env.BASE_URL)}>{link.label}</a>)}
  </nav>
</header>

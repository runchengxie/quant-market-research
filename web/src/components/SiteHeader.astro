---
import ThemeToggle from "./react/ThemeToggle";
import { withBase } from "../lib/routes";

interface Props { activeRoute: string; section?: "overview" | "research" | "docs" | "data" }

const { activeRoute, section } = Astro.props;
const resolvedSection = section ?? (activeRoute === "overview" ? "overview" : activeRoute === "docs" ? "docs" : activeRoute === "data" ? "data" : "research");
const links = [
  { id: "overview", section: "overview", label: "研究总览", href: "/" },
  { id: "research", section: "research", label: "研究专题", href: "/research/" },
  { id: "docs", section: "docs", label: "方法与字典", href: "/docs/" },
  { id: "data", section: "data", label: "数据与版本", href: "/data-sources/" },
];
---

<header class="site-header">
  <div class="site-masthead">
    <div>
      <span class="brand-kicker">历史市场研究 · 证据优先</span>
      <a class="site-brand" href={withBase("/", import.meta.env.BASE_URL)}>市场研究档案</a>
      <p class="site-deck">汇集历史市场研究，标明数据日期、研究进展和使用限制。</p>
    </div>
    <div class="site-meta">
      <span>公开研究 · 数据日期见下方</span>
      <strong>汇总结果 · 仅描述历史</strong>
      <ThemeToggle client:load />
    </div>
  </div>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="展开主导航">菜单</button>
  <nav id="primary-nav" class="site-nav" aria-label="主导航">
    {links.map((link) => <a class:list={{ active: resolvedSection === link.section }} href={withBase(link.href, import.meta.env.BASE_URL)}>{link.label}</a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>("#primary-nav");
  if (toggle && nav) {
    const close = () => { toggle.setAttribute("aria-expanded", "false"); nav.removeAttribute("data-open"); };
    toggle.addEventListener("click", () => { const open = toggle.getAttribute("aria-expanded") !== "true"; toggle.setAttribute("aria-expanded", String(open)); if (open) nav.setAttribute("data-open", ""); else nav.removeAttribute("data-open"); });
    nav.addEventListener("click", (event) => { if ((event.target as HTMLElement).matches("a")) close(); });
    document.addEventListener("keydown", (event) => { if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") { close(); toggle.focus(); } });
  }
</script>

---
import { withBase } from '../lib/routes';
interface Props { anchor: 'etf-rotation' | 'hotsector' }
const { anchor } = Astro.props;
const canonical = withBase('/research/style-theme-rotation/', import.meta.env.BASE_URL);
const target = `${canonical}#${anchor}`;
---
<!doctype html>
<html lang="en-US"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Style and theme rotation · moved</title><link rel="canonical" href={new URL(canonical, Astro.site)} />
<meta http-equiv="refresh" content={`0;url=${target}`} />
</head><body><p>This research is now part of <a href={target}>Style and theme rotation</a>.</p>
<script is:inline define:vars={{ canonical, anchor }}>
  const destination = new URL(canonical, window.location.origin);
  destination.search = window.location.search;
  destination.hash = window.location.hash || anchor;
  window.location.replace(destination.href);
</script>
</body></html>

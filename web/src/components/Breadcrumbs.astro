---
interface Props { items: readonly { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="面包屑">
  <ol>{items.map((item, index) => <li>{item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.label}</span>}</li>)}</ol>
</nav>

---
interface Props { items: readonly { label: string; labelEn?: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>{items.map((item, index) => <li>{item.href && index < items.length - 1 ? <a href={item.href} data-locale-text data-en={item.labelEn ?? item.label} data-zh={item.label}>{item.labelEn ?? item.label}</a> : <span data-locale-text data-en={item.labelEn ?? item.label} data-zh={item.label} aria-current={index === items.length - 1 ? "page" : undefined}>{item.labelEn ?? item.label}</span>}</li>)}</ol>
</nav>

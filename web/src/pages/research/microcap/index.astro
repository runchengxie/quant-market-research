import MicrocapResearchHub from "../../../components/research/MicrocapResearchHub.astro";
import ResearchPage from "../../../components/ResearchPage.astro";
import { MicrocapPage } from "../../../components/react/microcap-page";
import MicrocapMethod from "../../../components/research/MicrocapMethod.astro";
---
<ResearchPage sections={[{id:"microcap-evidence-recovery",label:"证据找回",labelEn:"Evidence recovery",available:true},{id:"microcap-coverage",label:"研究覆盖",labelEn:"Research coverage",available:true},{id:"microcap-map",label:"研究地图",labelEn:"Research map",available:true},{id:"microcap-window-evidence",label:"窗口对照",labelEn:"Window comparison",available:true},{id:"microcap-revisions",label:"结论修正",labelEn:"Revisions",available:true},{id:"microcap-open-questions",label:"待解问题",labelEn:"Open questions",available:true},{id:"microcap-history-evidence",label:"历史图表",labelEn:"Historical charts",available:true},{id:"research-method",label:"数据与方法",labelEn:"Sources and methods",available:true}]} title="A 股微盘历史研究" titleEn="A-share micro-cap history" description="A 股微盘参考指数与最小市值股票组合的收益、回撤和数据限制。" snapshotKey="microcap" activeRoute="microcap" kicker="小微盘研究：历史、因子与执行" kickerEn="Micro-cap research: history, factors and execution" introduction="这页汇集历史表现、规模暴露、低换手、组合规则、执行与跨市场流动性研究。先看证据地图，再比较图表、研究修正和未决问题。" introductionEn="Explore historical performance, size exposure, low turnover, portfolio rules, execution and cross-market liquidity. Start with the evidence map, then compare charts, revisions and open questions." boundary="参考指数、自建组合和不同市场样本分开展示。部分历史持仓缺少下一交易日价格，页面会说明缺口范围和处理方式。" boundaryEn="Reference indices, reconstructed portfolios, and other-market samples are shown separately. Missing next-day prices are disclosed with their scope and treatment." evidence="规则重建与数据审计" evidenceEn="Rule reconstruction and data audit" question="按固定规则选出的最小市值股票，长期收益和风险是什么样？数据缺口会改变多少结果？" questionEn="What long-run return and risk does a fixed smallest-cap rule produce, and how much can data gaps change the result?" nextStep="继续补充退市价格和实际交易成本，完善组合能否执行的判断。" nextStepEn="Add delisting prices and implementation costs to complete the executable-portfolio assessment.">
  <MicrocapResearchHub />
  <MicrocapHistory />
  <section id="microcap-history-evidence"><MicrocapPage client:load initialScope="a-share" /></section>
  <details class="panel"><summary data-locale-text data-en="How the experiment works" data-zh="这项实验怎么做">How the experiment works</summary><MicrocapMethod /></details>
</ResearchPage>

---
import TopicNav from '../../../../components/TopicNav.astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { liquidityResearchCopy as c } from '../../../../content/liquidity-research-copy';
import { withBase } from '../../../../lib/routes';
---
<SiteLayout title="跨市场小微盘流动性" titleEn="Cross-market micro-cap liquidity" description={c.lead[0]} section="research">
<TopicNav sections={[{id:"cross-market-summary",label:"研究说明",labelEn:"Research context",available:true},{id:"unified-entry",label:"统一专题",labelEn:"Unified study",available:true}]}/>
<section id="cross-market-summary" class="theme-heading"><div><h1 data-locale-text data-en="Cross-market micro-cap liquidity" data-zh="跨市场小微盘流动性">Cross-market micro-cap liquidity</h1><p data-locale-text data-en="This research now shares one entry with trading costs and capacity. Market profiles, quality checks, interactive charts and research notes are maintained there." data-zh="这项研究已与交易成本和策略容量共用一个入口。市场画像、质量核查、互动图表和研究笔记统一在该专题维护。">This research now shares one entry with trading costs and capacity. Market profiles, quality checks, interactive charts and research notes are maintained there.</p></div></section>
<p id="unified-entry"><a class="button-link" href={withBase('/research/liquidity/#market-profiles',import.meta.env.BASE_URL)} data-locale-link data-href-en={withBase("/research/liquidity/?lang=en-US#market-profiles",import.meta.env.BASE_URL)} data-href-zh={withBase("/research/liquidity/?lang=zh-CN#market-profiles",import.meta.env.BASE_URL)} data-locale-text data-en={c.unifiedLink[0]} data-zh={c.unifiedLink[1]}>{c.unifiedLink[0]}</a></p>
</SiteLayout>

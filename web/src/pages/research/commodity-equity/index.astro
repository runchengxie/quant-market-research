---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import T from '../../../components/LocaleText.astro';
import {commodityCopy as c, commodityPeriods as periods} from '../../../content/commodity-copy';
import first from '../../../../../studies/china_commodity_equity/reviewed-summary-20261107.json';
import follow from '../../../../../studies/china_commodity_equity/exploration-summary-20261108.json';
import next from '../../../../../studies/china_commodity_equity/next-summary-20261108.json';
import {withBase} from '../../../lib/routes';
const pct=(v:number)=>`${(100*v).toFixed(2)}%`;
const controls=[{id:'policy',label:c.policy,values:[['monthly',c.monthly],['annual',c.annual]]},{id:'weight',label:c.weight,values:['10','20','30','40'].map(x=>[x,[`${x}%`,`${x}%`]])},{id:'horizon',label:c.horizon,values:[['60',c.years5],['120',c.years10]]}];
const selected=follow.robustness.cases.monthly_20_60;
const metrics=[['count',String(selected.completed_windows)],['returnBetter',pct(selected.improves_return.fraction)],['drawdownBetter',pct(selected.improves_drawdown.fraction)],['both',pct(selected.improves_both.fraction)],['median',pct(selected.portfolio_cagr.median)],['worst',pct(selected.portfolio_cagr.minimum)],['worstDrawdown',pct(selected.portfolio_max_drawdown.minimum)]];
const recent=first.recent.period_returns;
const displayReturns=Object.fromEntries(Object.keys(periods).map(id=>{const key=id as keyof typeof recent.equity;return [id,{equity:recent.equity[key]??first.primary.period_returns.equity[key],commodity:recent.commodity[key]??first.primary.period_returns.commodity[key]}];}));
---
<SiteLayout title={c.title[1]} titleEn={c.title[0]} description={c.intro[0]} section="research">
<article class="commodity-study">
<h1><T text={c.title} as="span"/></h1><T text={c.intro}/><T text={c.sample}/>
<nav><a href="#windows"><T text={c.windows} as="span"/></a> · <a href="#risk"><T text={c.risk} as="span"/></a> · <a href="#contract"><T text={c.contract} as="span"/></a> · <a href="#archive"><T text={c.archive} as="span"/></a></nav>
<section id="windows" data-commodity-explorer><h2><T text={c.windows} as="span"/></h2><T text={c.help}/>
<div class="controls">{controls.map(control=><label><T text={control.label as readonly [string,string]} as="span"/><select data-commodity-control={control.id} aria-label={control.label[0]} data-locale-aria data-aria-en={control.label[0]} data-aria-zh={control.label[1]}>{control.values.map(([value,label])=><option value={value as string} selected={value===(control.id==='policy'?'monthly':control.id==='weight'?'20':'60')} data-locale-text data-en={label[0]} data-zh={label[1]}>{label[0]}</option>)}</select></label>)}</div>
<div data-commodity-chart class="chart" role="img" aria-label={c.windows[0]}></div><p data-commodity-status aria-live="polite"></p>
<table><thead><tr><th><T text={c.metric} as="span"/></th><th><T text={c.value} as="span"/></th></tr></thead><tbody>{metrics.map(([key,value])=><tr><td><T text={c[key as keyof typeof c]} as="span"/></td><td data-commodity-metric={key}>{value}</td></tr>)}</tbody></table>
<h3><T text={c.failure} as="span"/></h3><p data-commodity-failure>{selected.worst_return_difference_windows[0].start} — {selected.worst_return_difference_windows[0].end} · {pct(selected.worst_return_difference_windows[0].portfolio_cagr)} / {pct(selected.worst_return_difference_windows[0].equity_cagr)}</p>
<script type="application/json" is:inline data-commodity-payload set:html={JSON.stringify(follow.robustness.cases).replace(/</g,'\u003c')}/>
<noscript><p>{c.fallback[0]}</p><style>.controls,.chart{display:none}</style></noscript>
</section>
<section><h2><T text={c.returns} as="span"/></h2><div class="scroll"><table><thead><tr>{[c.period,c.start,c.end,c.stock,c.commodity].map(label=><th><T text={label} as="span"/></th>)}</tr></thead><tbody>{Object.entries(displayReturns).map(([id,pair])=><tr><td><T text={periods[id as keyof typeof periods]} as="span"/></td><td>{pair.equity?.start??'—'}</td><td>{pair.equity?.end??'—'}</td><td>{pair.equity?pct(pair.equity.return):'—'}</td><td>{pair.commodity?pct(pair.commodity.return):'—'}</td></tr>)}</tbody></table></div></section>
<section><h2><T text={c.costs} as="span"/></h2><T text={c.costHelp}/><table><thead><tr>{[c.fee,c.cagr,c.dd].map(label=><th><T text={label} as="span"/></th>)}</tr></thead><tbody>{follow.implementation.rebalance_cost_sensitivities.map(r=><tr><td>{r.cost_bps_per_two_sided_traded_notional}</td><td>{pct(r.cagr)}</td><td>{pct(r.max_drawdown)}</td></tr>)}</tbody></table></section>
<section id="risk"><h2><T text={c.risk} as="span"/></h2><T text={c.riskHelp}/><div class="scroll"><table><thead><tr>{[c.strategy,c.cagr,c.vol,c.dd].map(label=><th><T text={label} as="span"/></th>)}</tr></thead><tbody>{Object.entries(next.risk_controls.cases).map(([id,r])=><tr><td><T text={c[id as keyof typeof c]} as="span"/></td><td>{pct(r.cagr)}</td><td>{pct(r.daily_volatility_252)}</td><td>{pct(r.max_drawdown)}</td></tr>)}</tbody></table></div><T text={c.hindsight}/></section>
<section id="contract"><h2><T text={c.contract} as="span"/></h2><T text={c.contractHelp}/><table><thead><tr>{[c.ticks,c.accountReturn,c.dd,c.margin].map(label=><th><T text={label} as="span"/></th>)}</tr></thead><tbody>{next.contract_trial.cases.map(r=><tr><td>{r.slippage_ticks_per_traded_lot}</td><td>{pct(r.return_from_pre_entry_capital)}</td><td>{pct(r.daily_max_drawdown_including_entry)}</td><td>{pct(r.max_margin_fraction)}</td></tr>)}</tbody></table><T text={c.contractLimit}/></section>
<section><h2><T text={c.etf} as="span"/></h2><T text={c.etfHelp}/><div class="scroll"><table><thead><tr>{[c.product,c.start,c.end,c.market,c.nav].map(label=><th><T text={label} as="span"/></th>)}</tr></thead><tbody>{Object.entries(follow.implementation.products).map(([id,r])=><tr><td>{id}</td><td>{r.start}</td><td>{r.end}</td><td>{pct(r.market_cagr_proxy)}</td><td>{pct(r.adjusted_nav_cagr_proxy)}</td></tr>)}</tbody></table></div></section>
<section id="archive"><h2><T text={c.archive} as="span"/></h2><T text={c.archiveHelp}/><div class="scroll"><table><thead><tr>{[c.dataset,c.rows,c.observed].map(label=><th><T text={label} as="span"/></th>)}</tr></thead><tbody>{next.prospective_archive.snapshots.map(r=><tr><td>{r.dataset}</td><td>{r.rows}</td><td>{r.retrieved_at}</td></tr>)}</tbody></table></div></section>
<section><h2><T text={c.evidence} as="span"/></h2><p><a href="https://github.com/runchengxie/quant-market-research/blob/main/studies/china_commodity_equity/next-20261108.md"><T text={c.report} as="span"/></a> · <a href={withBase('/docs/research/asset-returns/china-commodity-equity/', import.meta.env.BASE_URL)}><T text={c.protocol} as="span"/></a></p></section>
</article>
</SiteLayout>
<script>
import {mountCommodityExplorer} from '../../../components/commodity-explorer';
mountCommodityExplorer();
</script>
<style>.commodity-study{max-width:1050px;margin:auto;min-width:0}.commodity-study p{max-width:78ch;line-height:1.85}.commodity-study section{margin-block:2.5rem}.controls{display:flex;gap:1rem;flex-wrap:wrap}.controls label{display:grid;gap:.4rem}.controls select{padding:.5rem;max-width:100%}.chart{height:310px;width:100%}.scroll{overflow-x:auto}table{width:100%;font-size:.92rem}td,th{padding:.65rem;text-align:left}.commodity-study :global([id]){scroll-margin-top:8rem}@media(max-width:480px){table{font-size:.8rem}.controls{gap:.6rem}}</style>

---
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { withBase } from "../../../../lib/routes";
import LowTurnoverExecutionEvidence from "../../../../components/LowTurnoverExecutionEvidence";
import TopicNav from "../../../../components/TopicNav.astro";
const base = import.meta.env.BASE_URL ?? "/";
const docsUrl = withBase("/docs/research/factors/low-turnover/", base);
const controls = [
  { label: "Raw signal", labelZh: "原始信号", low: 1.08, high: -0.30, spread: 1.38, ciLow: 0.93, ciHigh: 1.91 },
  { label: "Control for size", labelZh: "控制规模", low: 1.29, high: -0.34, spread: 1.63, ciLow: 1.23, ciHigh: 2.06 },
  { label: "Add low volatility", labelZh: "加入低波动", low: 0.73, high: -0.13, spread: 0.86, ciLow: 0.57, ciHigh: 1.18 },
  { label: "Add existing controls", labelZh: "加入现有控制", low: 1.03, high: -0.18, spread: 1.21, ciLow: 0.87, ciHigh: 1.64 },
];
---
<SiteLayout title="低换手因子研究" titleEn="Low-turnover factor research" description="低换手因子的历史关系、归因证据、可交易性和下一步验证。" activeRoute="low-turnover">
  <TopicNav sections={[{ id: "topic-content", label: "主要发现", labelEn: "Key findings", available: true }, { id: "control-evidence", label: "控制变量", labelEn: "Controls", available: true }, { id: "research-method", label: "执行与方法", labelEn: "Execution and method", available: true }]} />
  <article id="topic-content" class="research-report">
    <header class="theme-heading"><div><span class="section-kicker" data-locale-text data-en="Factors and style · exploratory research" data-zh="因子与风格 · 探索性研究">Factors and style · exploratory research</span><h1 data-locale-text data-en="Low-turnover factor: what information remains?" data-zh="低换手因子：它保留了什么信息？">Low-turnover factor: what information remains?</h1><p data-locale-text data-en="Low turnover means relatively few shares change hands during a period. This report asks whether stocks with lower turnover performed differently in the past, and whether that difference remains after accounting for size, volatility, and trading activity." data-zh="低换手表示一段时间内相对较少的股票换手成交。本报告检查低换手股票过去的表现是否不同，以及把规模、波动和交易活跃度考虑进去后，这种差异是否还存在。">Low turnover means relatively few shares change hands during a period. This report asks whether stocks with lower turnover performed differently in the past, and whether that difference remains after accounting for size, volatility, and trading activity.</p></div><span class="evidence-status exploratory" data-locale-text data-en="Evidence status · exploratory" data-zh="证据状态 · 探索性">Evidence status · exploratory</span></header>
    <section class="report-section report-conclusion"><span class="section-kicker" data-locale-text data-en="Key finding" data-zh="先看结论">Key finding</span><h3 data-locale-text data-en="Low-turnover stocks did better in some historical comparisons, but the data does not show that low turnover itself caused the difference." data-zh="在一些历史对照中，低换手股票表现更好；但数据还不能说明差异是低换手本身造成的。">Low-turnover stocks did better in some historical comparisons, but the data does not show that low turnover itself caused the difference.</h3><p data-locale-text data-en="From May 2019 to June 2026, the low-turnover group averaged 1.38 percentage points more per month than the high-turnover group. This gap was 0.86 points after also accounting for low volatility and 1.21 points after the other listed controls. A separate regression found that a one-standard-deviation higher low-turnover score went with a 0.60-point higher average next-period return. These are historical comparisons, not the returns of a tested trading account." data-zh="2019 年 5 月至 2026 年 6 月，低换手组的月均收益比高换手组高约 1.38 个百分点。再考虑低波动后，差值约为 0.86 个百分点；考虑其他已列出的特征后，约为 1.21 个百分点。另一项回归发现，低换手得分每高一个标准差，下一期平均收益高约 0.60 个百分点。这些都是历史比较结果，不是经过真实交易验证的账户收益。">From May 2019 to June 2026, the low-turnover group averaged 1.38 percentage points more per month than the high-turnover group. This gap was 0.86 points after also accounting for low volatility and 1.21 points after the other listed controls. A separate regression found that a one-standard-deviation higher low-turnover score went with a 0.60-point higher average next-period return. These are historical comparisons, not the returns of a tested trading account.</p><p data-locale-text data-en="The figures show a past relationship, but lower turnover overlaps with other stock features such as volatility and trading activity. Only one forward month has been observed so far, which is too little to tell whether the pattern will continue or could be traded reliably." data-zh="这些数字显示的是过去的关系，但低换手也和波动、交易活跃度等股票特征重叠。目前只有一个前瞻月份，无法据此判断这种关系能否持续或能否稳定交易。">The figures show a past relationship, but lower turnover overlaps with other stock features such as volatility and trading activity. Only one forward month has been observed so far, which is too little to tell whether the pattern will continue or could be traded reliably.</p></section>
    <section class="stat-grid report-stats"><article class="stat accent"><span data-locale-text data-en="Common sample" data-zh="共同样本">Common sample</span><strong>86 months</strong><small>2019-05 to 2026-06</small></article><article class="stat"><span data-locale-text data-en="Raw low minus high" data-zh="原始低减高">Raw low minus high</span><strong>+1.38%</strong><small data-locale-text data-en="Mean monthly return spread" data-zh="月均收益差">Mean monthly return spread</small></article><article class="stat"><span data-locale-text data-en="With low volatility" data-zh="加入低波动">With low volatility</span><strong>+0.86%</strong><small data-locale-text data-en="Mean monthly return spread" data-zh="月均收益差">Mean monthly return spread</small></article><article class="stat"><span data-locale-text data-en="Joint regression" data-zh="联合回归">Joint regression</span><strong>+0.60%</strong><small data-locale-text data-en="Average difference per 1 standard deviation" data-zh="得分每高 1 个标准差对应的平均差异">Average difference per 1 standard deviation</small></article><article class="stat"><span data-locale-text data-en="Forward sample" data-zh="前瞻样本">Forward sample</span><strong>1 month</strong><small data-locale-text data-en="Longer-term persistence is unknown" data-zh="尚不能判断长期重复性">Longer-term persistence is unknown</small></article></section>
    <section id="control-evidence" class="report-section"><span class="section-kicker" data-locale-text data-en="Common sample · 86 months" data-zh="共同样本 · 86 个月">Common sample · 86 months</span><h3 data-locale-text data-en="Controls change the spread and the performance at both ends" data-zh="控制变量改变差值，也改变两端的表现">Controls change the spread and the performance at both ends</h3><p data-locale-text data-en="For the same 86 months, each dot shows how much the low-turnover group outperformed the high-turnover group on average per month. The line shows a 95% range estimated by resampling blocks of neighboring months, which allows nearby months to move together. The right column shows each group separately so you can see where the gap came from." data-zh="同样的 86 个月中，圆点表示低换手组每月平均比高换手组多出的收益。线段是通过成组重抽相邻月份估算的 95% 范围，允许相邻月份受同一市场阶段影响。右侧分别列出两组收益，便于看出差距来自哪一端。">For the same 86 months, each dot shows how much the low-turnover group outperformed the high-turnover group on average per month. The line shows a 95% range estimated by resampling blocks of neighboring months, which allows nearby months to move together. The right column shows each group separately so you can see where the gap came from.</p><figure class="evidence-figure" aria-labelledby="control-chart-title"><figcaption id="control-chart-title" data-locale-text data-en="Average monthly return gap and its 95% range" data-zh="低换手组与高换手组的月均收益差及其 95% 范围">Average monthly return gap and its 95% range</figcaption><div class="interval-axis" aria-hidden="true"><span>0</span><span>0.55</span><span>1.10</span><span>1.65</span><span>2.20%</span></div><div class="interval-rows">{controls.map((row) => <div class="interval-row"><span class="interval-label" data-locale-text data-en={row.label} data-zh={row.labelZh}>{row.label}</span><div class="interval-track" style={`--interval-left: ${row.ciLow / 2.2 * 100}%; --interval-width: ${(row.ciHigh - row.ciLow) / 2.2 * 100}%; --point-left: ${row.spread / 2.2 * 100}%`}><span class="interval-range"></span><span class="interval-point"></span></div><div class="interval-values"><strong>+{row.spread.toFixed(2)}%</strong><small><span data-locale-text data-en="95% estimated range" data-zh="95% 估算范围">95% estimated range</span> {row.ciLow.toFixed(2)}–{row.ciHigh.toFixed(2)}%</small></div><small class="interval-legs"><span data-locale-text data-en="Low turnover" data-zh="低换手">Low turnover</span> {row.low > 0 ? "+" : ""}{row.low.toFixed(2)}% <span aria-hidden="true">·</span> <span data-locale-text data-en="High turnover" data-zh="高换手">High turnover</span> {row.high > 0 ? "+" : ""}{row.high.toFixed(2)}%</small></div>)}</div><p class="evidence-figure-note" data-locale-text data-en="Sequential controls are sensitivity checks for conditional associations. The features are interrelated, so changes in the spread cannot be interpreted as the causal contribution of one variable. The two sides are theoretical group returns, not directly executable long-short portfolios." data-zh="逐步控制是条件关联的敏感性检查；各特征相互关联，差值变化不能解释成单个变量的因果贡献。两端收益为理论分组收益，并非可直接成交的多空组合。">Sequential controls are sensitivity checks for conditional associations. The features are interrelated, so changes in the spread cannot be interpreted as the causal contribution of one variable. The two sides are theoretical group returns, not directly executable long-short portfolios.</p></figure></section>
    <section class="report-section"><span class="section-kicker" data-locale-text data-en="Interpreting the factor" data-zh="怎么理解这个因子">Interpreting the factor</span><h3 data-locale-text data-en="Low turnover is better viewed as a bundle of information" data-zh="低换手更像一个信息集合">Low turnover is better viewed as a bundle of information</h3><div class="research-grid"><article class="research-card"><h3 data-locale-text data-en="Low volatility" data-zh="低波动">Low volatility</h3><p data-locale-text data-en="Historical return series for low turnover and low volatility are highly correlated. The spread narrows materially after controlling for low volatility, indicating shared information." data-zh="低换手与低波动的历史收益序列相关性较高。控制低波动后差值明显收窄，说明两者有一部分共同信息。">Historical return series for low turnover and low volatility are highly correlated. The spread narrows materially after controlling for low volatility, indicating shared information.</p></article><article class="research-card"><h3 data-locale-text data-en="Trading activity" data-zh="交易活跃度">Trading activity</h3><p data-locale-text data-en="Turnover, traded value, and the Amihud measure describe different aspects of the trading environment. Controlling for them changes the ranking signal and may also control away part of what low turnover represents." data-zh="换手率、成交额和 Amihud 指标描述交易环境的不同侧面。控制它们后，排序信息会变化，也可能把低换手的构成部分一起控制掉。">Turnover, traded value, and the Amihud measure describe different aspects of the trading environment. Controlling for them changes the ranking signal and may also control away part of what low turnover represents.</p></article><article class="research-card"><h3 data-locale-text data-en="High-turnover reversal" data-zh="高换手反转">High-turnover reversal</h3><p data-locale-text data-en="Earlier results show weaker performance on the high-turnover side. Returns may come mainly from avoiding crowded and speculative trading rather than persistent gains at the very-low-turnover end." data-zh="早期结果中，高换手端表现较差。收益可能主要来自避开拥挤和投机交易，而不是最低换手端持续上涨。">Earlier results show weaker performance on the high-turnover side. Returns may come mainly from avoiding crowded and speculative trading rather than persistent gains at the very-low-turnover end.</p></article></div></section>
    <section class="report-section"><span class="section-kicker" data-locale-text data-en="Evidence boundaries" data-zh="证据边界">Evidence boundaries</span><h3 data-locale-text data-en="Read the current results through three questions" data-zh="当前结果需要按三个问题阅读">Read the current results through three questions</h3><ol class="report-list"><li><strong data-locale-text data-en="What is the sample?" data-zh="样本是什么。">What is the sample?</strong> <span data-locale-text data-en="The latest common sample includes stocks with positive price-to-earnings ratios and does not represent all A-shares." data-zh="最新共同样本包含正市盈率股票，不能直接代表全部 A 股。">The latest common sample includes stocks with positive price-to-earnings ratios and does not represent all A-shares.</span></li><li><strong data-locale-text data-en="What was known at formation?" data-zh="形成时知道什么。">What was known at formation?</strong> <span data-locale-text data-en="Removing securities with future missing prices before grouping changes portfolio membership. Portfolio tests must first fix the formation-date universe and weights." data-zh="分组前删除未来缺价股票会改变组合名单，组合检验必须先固定形成日名单和权重。">Removing securities with future missing prices before grouping changes portfolio membership. Portfolio tests must first fix the formation-date universe and weights.</span></li><li><strong data-locale-text data-en="Could the portfolio trade?" data-zh="能不能成交。">Could the portfolio trade?</strong> <span data-locale-text data-en="Theoretical long-short returns for low-turnover portfolios are materially higher than net long-only results. Suspensions, price limits, traded value, and market impact need validation in one consistent ledger." data-zh="低换手组合的理论多空收益明显高于扣成本多头结果，停牌、涨跌停、成交额和冲击成本需要统一账本验证。">Theoretical long-short returns for low-turnover portfolios are materially higher than net long-only results. Suspensions, price limits, traded value, and market impact need validation in one consistent ledger.</span></li></ol></section>
    <section class="report-section report-next"><span class="section-kicker" data-locale-text data-en="Next steps" data-zh="下一步">Next steps</span><h3 data-locale-text data-en="Test incremental value before expanding mechanism claims" data-zh="先验证增量价值，再扩展机制解释">Test incremental value before expanding mechanism claims</h3><p data-locale-text data-en="Fix the same universe, share-based ledger, and cost assumptions, then compare a benchmark portfolio, one excluding the highest-turnover group, and one tilted toward low turnover. Next, separate 1-, 20-, and 60-day turnover to distinguish persistently low turnover from short-lived volume spikes. Register code version, input snapshot, membership, weights, and evaluation metrics before each forward test begins." data-zh="固定同一股票池、同一份额账本和成本设定，比较基准组合、剔除最高换手组和偏向低换手组。随后把 1 日、20 日和 60 日换手拆开，区分长期低换手与短期异常放量。所有前瞻检验在持有期开始前登记代码版本、输入快照、名单、权重和评价指标。">Fix the same universe, share-based ledger, and cost assumptions, then compare a benchmark portfolio, one excluding the highest-turnover group, and one tilted toward low turnover. Next, separate 1-, 20-, and 60-day turnover to distinguish persistently low turnover from short-lived volume spikes. Register code version, input snapshot, membership, weights, and evaluation metrics before each forward test begins.</p></section>
    <span id="research-method" class="anchor-target"></span><LowTurnoverExecutionEvidence client:load />
    <nav class="report-links" aria-label="Low-turnover research links"><a class="button-link" data-locale-text data-en="Read the full methodology ↗" data-zh="阅读完整方法说明 ↗" href={docsUrl}>Read the full methodology ↗</a><a class="button-link secondary" data-locale-text data-en="View 18-year style-factor research ↗" data-zh="查看 18 年风格因子 ↗" href={withBase("/research/style-factors-18y/", base)}>View 18-year style-factor research ↗</a></nav>
  </article>
</SiteLayout>

---
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { withBase } from "../../../../lib/routes";
import LowTurnoverExecutionEvidence from "../../../../components/LowTurnoverExecutionEvidence";
import TopicNav from "../../../../components/TopicNav.astro";
const base = import.meta.env.BASE_URL ?? "/";
const docsUrl = withBase("/docs/research/factors/low-turnover/", base);
const controls = [
  { label: "Raw signal", labelZh: "原始信号", low: 1.08, high: -0.30, spread: 1.38, ciLow: 0.93, ciHigh: 1.91 },
  { label: "Control for size", labelZh: "控制规模", low: 1.29, high: -0.34, spread: 1.63, ciLow: 1.23, ciHigh: 2.06 },
  { label: "Add low volatility", labelZh: "加入低波动", low: 0.73, high: -0.13, spread: 0.86, ciLow: 0.57, ciHigh: 1.18 },
  { label: "Add existing controls", labelZh: "加入现有控制", low: 1.03, high: -0.18, spread: 1.21, ciLow: 0.87, ciHigh: 1.64 },
];
---
<SiteLayout title="低换手因子研究" titleEn="Low-turnover factor research" description="低换手因子的历史关系、归因证据、可交易性和下一步验证。" activeRoute="low-turnover">
  <TopicNav sections={[{ id: "topic-content", label: "主要发现", labelEn: "Key findings", available: true }, { id: "control-evidence", label: "控制变量", labelEn: "Controls", available: true }, { id: "research-method", label: "执行与方法", labelEn: "Execution and method", available: true }]} />
  <article id="topic-content" class="research-report">
    <header class="theme-heading"><div><span class="section-kicker" data-locale-text data-en="Factors and style · exploratory research" data-zh="因子与风格 · 探索性研究">Factors and style · exploratory research</span><h1 data-locale-text data-en="Low-turnover factor: what information remains?" data-zh="低换手因子：它保留了什么信息？">Low-turnover factor: what information remains?</h1><p data-locale-text data-en="This report follows the historical pattern, factor attribution, and portfolio execution in one reading path. The central question is whether low turnover retains stable incremental information after controlling for size, volatility, and liquidity." data-zh="这份报告把历史现象、因子归因和组合执行放在同一条阅读路径中。核心问题是：低换手在控制规模、波动和流动性特征后，是否还带来稳定的增量信息。">This report follows the historical pattern, factor attribution, and portfolio execution in one reading path. The central question is whether low turnover retains stable incremental information after controlling for size, volatility, and liquidity.</p></div><span class="evidence-status exploratory" data-locale-text data-en="Evidence status · exploratory" data-zh="证据状态 · 探索性">Evidence status · exploratory</span></header>
    <section class="report-section report-conclusion"><span class="section-kicker" data-locale-text data-en="Key finding" data-zh="先看结论">Key finding</span><h3 data-locale-text data-en="Low turnover remains conditionally associated with historical returns, but an independent premium is not established." data-zh="低换手仍有历史条件相关性，但还不能当作已确认的独立溢价。">Low turnover remains conditionally associated with historical returns, but an independent premium is not established.</h3><p data-locale-text data-en="In the common sample from May 2019 through June 2026, the average monthly low-minus-high turnover spread was about 1.38%. It persisted after controlling for size, narrowed to about 0.86% after adding low volatility, and was about 1.21% with the existing controls. A joint cross-sectional regression found that a one-standard-deviation increase in the low-turnover score was associated with an average 0.60 percentage-point increase in next-period conditional mean returns." data-zh="在 2019 年 5 月至 2026 年 6 月的共同样本中，低换手减高换手的月均差值约为 1.38%。控制规模后没有消失，加入低波动后收窄到约 0.86%，加入现有控制变量后约为 1.21%。联合截面回归显示，低换手得分每高一个标准差，下一期收益条件均值平均高约 0.60 个百分点。">In the common sample from May 2019 through June 2026, the average monthly low-minus-high turnover spread was about 1.38%. It persisted after controlling for size, narrowed to about 0.86% after adding low volatility, and was about 1.21% with the existing controls. A joint cross-sectional regression found that a one-standard-deviation increase in the low-turnover score was associated with an average 0.60 percentage-point increase in next-period conditional mean returns.</p><p data-locale-text data-en="These results indicate that low turnover helps distinguish subsequent historical returns. They may also combine information about low volatility, trading activity, liquidity risk, and reversal among high-turnover stocks. A one-month forward holding period and current portfolio-cost results are not enough to establish stable tradability." data-zh="这些结果说明低换手有助于区分历史上的后续收益。它们同时可能混合了低波动、交易活跃度、流动性风险和高换手股票的反转表现。一个月的前瞻持有期和当前组合成本结果，还不足以证明可以稳定交易。">These results indicate that low turnover helps distinguish subsequent historical returns. They may also combine information about low volatility, trading activity, liquidity risk, and reversal among high-turnover stocks. A one-month forward holding period and current portfolio-cost results are not enough to establish stable tradability.</p></section>
    <section class="stat-grid report-stats"><article class="stat accent"><span data-locale-text data-en="Common sample" data-zh="共同样本">Common sample</span><strong>86 months</strong><small>2019-05 to 2026-06</small></article><article class="stat"><span data-locale-text data-en="Raw low minus high" data-zh="原始低减高">Raw low minus high</span><strong>+1.38%</strong><small data-locale-text data-en="Mean monthly return spread" data-zh="月均收益差">Mean monthly return spread</small></article><article class="stat"><span data-locale-text data-en="With low volatility" data-zh="加入低波动">With low volatility</span><strong>+0.86%</strong><small data-locale-text data-en="Mean monthly return spread" data-zh="月均收益差">Mean monthly return spread</small></article><article class="stat"><span data-locale-text data-en="Joint regression" data-zh="联合回归">Joint regression</span><strong>+0.60%</strong><small data-locale-text data-en="Conditional mean per standard deviation" data-zh="每个标准差的条件均值">Conditional mean per standard deviation</small></article><article class="stat"><span data-locale-text data-en="Forward sample" data-zh="前瞻样本">Forward sample</span><strong>1 month</strong><small data-locale-text data-en="Longer-term persistence is unknown" data-zh="尚不能判断长期重复性">Longer-term persistence is unknown</small></article></section>
    <section id="control-evidence" class="report-section"><span class="section-kicker" data-locale-text data-en="Common sample · 86 months" data-zh="共同样本 · 86 个月">Common sample · 86 months</span><h3 data-locale-text data-en="Controls change the spread and the performance at both ends" data-zh="控制变量改变差值，也改变两端的表现">Controls change the spread and the performance at both ends</h3><p data-locale-text data-en="For the same formation months from 2019-05 through 2026-06, each dot shows the mean monthly low-minus-high turnover return spread and each line its 95% block interval. All four rows share a 0–2.2 percentage-point axis. The right column reports mean monthly returns for the low- and high-turnover sides to show where the spread comes from." data-zh="2019-05 至 2026-06 的同一组形成月里，图中的圆点是低换手减高换手的月均收益差，线段是 95% 区块区间。四行使用相同的 0–2.2 个百分点横轴；右侧列出低、高换手两端的月均收益，便于看清差值来自哪里。">For the same formation months from 2019-05 through 2026-06, each dot shows the mean monthly low-minus-high turnover return spread and each line its 95% block interval. All four rows share a 0–2.2 percentage-point axis. The right column reports mean monthly returns for the low- and high-turnover sides to show where the spread comes from.</p><figure class="evidence-figure" aria-labelledby="control-chart-title"><figcaption id="control-chart-title" data-locale-text data-en="Mean monthly low-minus-high return spread and block intervals" data-zh="低换手减高换手月均收益差与区块区间">Mean monthly low-minus-high return spread and block intervals</figcaption><div class="interval-axis" aria-hidden="true"><span>0</span><span>0.55</span><span>1.10</span><span>1.65</span><span>2.20%</span></div><div class="interval-rows">{controls.map((row) => <div class="interval-row"><span class="interval-label" data-locale-text data-en={row.label} data-zh={row.labelZh}>{row.label}</span><div class="interval-track" style={`--interval-left: ${row.ciLow / 2.2 * 100}%; --interval-width: ${(row.ciHigh - row.ciLow) / 2.2 * 100}%; --point-left: ${row.spread / 2.2 * 100}%`}><span class="interval-range"></span><span class="interval-point"></span></div><div class="interval-values"><strong>+{row.spread.toFixed(2)}%</strong><small><span data-locale-text data-en="95% interval" data-zh="95% 区间">95% interval</span> {row.ciLow.toFixed(2)}–{row.ciHigh.toFixed(2)}%</small></div><small class="interval-legs"><span data-locale-text data-en="Low turnover" data-zh="低换手">Low turnover</span> {row.low > 0 ? "+" : ""}{row.low.toFixed(2)}% <span aria-hidden="true">·</span> <span data-locale-text data-en="High turnover" data-zh="高换手">High turnover</span> {row.high > 0 ? "+" : ""}{row.high.toFixed(2)}%</small></div>)}</div><p class="evidence-figure-note" data-locale-text data-en="Sequential controls are sensitivity checks for conditional associations. The features are interrelated, so changes in the spread cannot be interpreted as the causal contribution of one variable. The two sides are theoretical group returns, not directly executable long-short portfolios." data-zh="逐步控制是条件关联的敏感性检查；各特征相互关联，差值变化不能解释成单个变量的因果贡献。两端收益为理论分组收益，并非可直接成交的多空组合。">Sequential controls are sensitivity checks for conditional associations. The features are interrelated, so changes in the spread cannot be interpreted as the causal contribution of one variable. The two sides are theoretical group returns, not directly executable long-short portfolios.</p></figure></section>
    <section class="report-section"><span class="section-kicker" data-locale-text data-en="Interpreting the factor" data-zh="怎么理解这个因子">Interpreting the factor</span><h3 data-locale-text data-en="Low turnover is better viewed as a bundle of information" data-zh="低换手更像一个信息集合">Low turnover is better viewed as a bundle of information</h3><div class="research-grid"><article class="research-card"><h3 data-locale-text data-en="Low volatility" data-zh="低波动">Low volatility</h3><p data-locale-text data-en="Historical return series for low turnover and low volatility are highly correlated. The spread narrows materially after controlling for low volatility, indicating shared information." data-zh="低换手与低波动的历史收益序列相关性较高。控制低波动后差值明显收窄，说明两者有一部分共同信息。">Historical return series for low turnover and low volatility are highly correlated. The spread narrows materially after controlling for low volatility, indicating shared information.</p></article><article class="research-card"><h3 data-locale-text data-en="Trading activity" data-zh="交易活跃度">Trading activity</h3><p data-locale-text data-en="Turnover, traded value, and the Amihud measure describe different aspects of the trading environment. Controlling for them changes the ranking signal and may also control away part of what low turnover represents." data-zh="换手率、成交额和 Amihud 指标描述交易环境的不同侧面。控制它们后，排序信息会变化，也可能把低换手的构成部分一起控制掉。">Turnover, traded value, and the Amihud measure describe different aspects of the trading environment. Controlling for them changes the ranking signal and may also control away part of what low turnover represents.</p></article><article class="research-card"><h3 data-locale-text data-en="High-turnover reversal" data-zh="高换手反转">High-turnover reversal</h3><p data-locale-text data-en="Earlier results show weaker performance on the high-turnover side. Returns may come mainly from avoiding crowded and speculative trading rather than persistent gains at the very-low-turnover end." data-zh="早期结果中，高换手端表现较差。收益可能主要来自避开拥挤和投机交易，而不是最低换手端持续上涨。">Earlier results show weaker performance on the high-turnover side. Returns may come mainly from avoiding crowded and speculative trading rather than persistent gains at the very-low-turnover end.</p></article></div></section>
    <section class="report-section"><span class="section-kicker" data-locale-text data-en="Evidence boundaries" data-zh="证据边界">Evidence boundaries</span><h3 data-locale-text data-en="Read the current results through three questions" data-zh="当前结果需要按三个问题阅读">Read the current results through three questions</h3><ol class="report-list"><li><strong data-locale-text data-en="What is the sample?" data-zh="样本是什么。">What is the sample?</strong> <span data-locale-text data-en="The latest common sample includes stocks with positive price-to-earnings ratios and does not represent all A-shares." data-zh="最新共同样本包含正市盈率股票，不能直接代表全部 A 股。">The latest common sample includes stocks with positive price-to-earnings ratios and does not represent all A-shares.</span></li><li><strong data-locale-text data-en="What was known at formation?" data-zh="形成时知道什么。">What was known at formation?</strong> <span data-locale-text data-en="Removing securities with future missing prices before grouping changes portfolio membership. Portfolio tests must first fix the formation-date universe and weights." data-zh="分组前删除未来缺价股票会改变组合名单，组合检验必须先固定形成日名单和权重。">Removing securities with future missing prices before grouping changes portfolio membership. Portfolio tests must first fix the formation-date universe and weights.</span></li><li><strong data-locale-text data-en="Could the portfolio trade?" data-zh="能不能成交。">Could the portfolio trade?</strong> <span data-locale-text data-en="Theoretical long-short returns for low-turnover portfolios are materially higher than net long-only results. Suspensions, price limits, traded value, and market impact need validation in one consistent ledger." data-zh="低换手组合的理论多空收益明显高于扣成本多头结果，停牌、涨跌停、成交额和冲击成本需要统一账本验证。">Theoretical long-short returns for low-turnover portfolios are materially higher than net long-only results. Suspensions, price limits, traded value, and market impact need validation in one consistent ledger.</span></li></ol></section>
    <section class="report-section report-next"><span class="section-kicker" data-locale-text data-en="Next steps" data-zh="下一步">Next steps</span><h3 data-locale-text data-en="Test incremental value before expanding mechanism claims" data-zh="先验证增量价值，再扩展机制解释">Test incremental value before expanding mechanism claims</h3><p data-locale-text data-en="Fix the same universe, share-based ledger, and cost assumptions, then compare a benchmark portfolio, one excluding the highest-turnover group, and one tilted toward low turnover. Next, separate 1-, 20-, and 60-day turnover to distinguish persistently low turnover from short-lived volume spikes. Register code version, input snapshot, membership, weights, and evaluation metrics before each forward test begins." data-zh="固定同一股票池、同一份额账本和成本设定，比较基准组合、剔除最高换手组和偏向低换手组。随后把 1 日、20 日和 60 日换手拆开，区分长期低换手与短期异常放量。所有前瞻检验在持有期开始前登记代码版本、输入快照、名单、权重和评价指标。">Fix the same universe, share-based ledger, and cost assumptions, then compare a benchmark portfolio, one excluding the highest-turnover group, and one tilted toward low turnover. Next, separate 1-, 20-, and 60-day turnover to distinguish persistently low turnover from short-lived volume spikes. Register code version, input snapshot, membership, weights, and evaluation metrics before each forward test begins.</p></section>
    <span id="research-method" class="anchor-target"></span><LowTurnoverExecutionEvidence client:load />
    <nav class="report-links" aria-label="Low-turnover research links"><a class="button-link" data-locale-text data-en="Read the full methodology ↗" data-zh="阅读完整方法说明 ↗" href={docsUrl}>Read the full methodology ↗</a><a class="button-link secondary" data-locale-text data-en="View 18-year style-factor research ↗" data-zh="查看 18 年风格因子 ↗" href={withBase("/research/style-factors-18y/", base)}>View 18-year style-factor research ↗</a></nav>
  </article>
</SiteLayout>

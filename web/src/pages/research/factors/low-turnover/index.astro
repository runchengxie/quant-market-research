---
import ClaimReview from '../../../../components/ClaimReview.astro';
import ResearchImageExport from '../../../../components/ResearchImageExport';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { withBase } from '../../../../lib/routes';
import LowTurnoverExecutionEvidence from '../../../../components/LowTurnoverExecutionEvidence';
import TopicNav from '../../../../components/TopicNav.astro';
import LocaleText from '../../../../components/LocaleText.astro';
import { lowTurnoverCopy as c, lowTurnoverControls as controls, lowTurnoverEvidence as evidence } from '../../../../content/low-turnover-copy';
const base = import.meta.env.BASE_URL ?? '/';
const docsUrl = withBase('/docs/research/factors/low-turnover/', base);
---
<SiteLayout title={c.title[1]} titleEn={c.title[0]} description={c.description[1]} activeRoute="low-turnover">
  <TopicNav sections={[{ id: 'topic-content', label: c.findings[1], labelEn: c.findings[0], available: true }, { id: 'control-evidence', label: '分组比较', labelEn: 'Group comparisons', available: true }, { id: 'research-method', label: '模拟交易与方法', labelEn: 'Trading simulations and method', available: true }]} />
  <article id="topic-content" class="research-report">
    <header class="theme-heading"><div><LocaleText as="span" class="section-kicker" text={c.kicker} /><LocaleText as="h1" text={c.title} /><LocaleText text={c.introduction} /></div><LocaleText as="span" class="evidence-status exploratory" text={c.status} /></header>
    <section class="report-section report-conclusion" data-testid="low-turnover-conclusion">
      <LocaleText as="span" class="section-kicker" text={c.findings} /><LocaleText as="h3" text={c.conclusion} />
      <LocaleText text={c.lead} /><LocaleText text={c.scope} /><LocaleText class="panel-note" text={c.date} />
    </section>
    <ResearchImageExport client:load />
    <section class="stat-grid report-stats">
      <article class="stat accent"><LocaleText as="span" text={c.common} /><LocaleText as="strong" text={c.months} /><small><LocaleText as="span" text={c.formation} /></small></article>
      <article class="stat"><LocaleText as="span" text={c.raw} /><strong>+{controls[0].spread.toFixed(2)}</strong><small><LocaleText as="span" text={c.spreadUnit} /></small></article>
      <article class="stat"><LocaleText as="span" text={c.full} /><strong>+{controls[3].spread.toFixed(2)}</strong><small><LocaleText as="span" text={c.spreadUnit} /></small></article>
      <article class="stat"><LocaleText as="span" text={c.observed} /><LocaleText as="strong" text={c.oneMonth} /><small><LocaleText as="span" text={c.registration} /></small></article>
    </section>
    <section id="control-evidence" class="report-section">
      <LocaleText as="h3" text={c.controls} /><LocaleText text={c.controlsLead} /><LocaleText text={c.controlsList} />
      <figure class="evidence-figure" aria-labelledby="control-chart-title">
        <figcaption id="control-chart-title"><LocaleText as="span" text={c.chart} /></figcaption>
        <div class="interval-axis" aria-hidden="true"><span>0</span><span>0.55</span><span>1.10</span><span>1.65</span><span>2.20</span></div>
        <div class="interval-rows">{controls.map(row => <div class="interval-row" data-control-stage={row.id}>
          <LocaleText as="span" class="interval-label" text={row.label} />
          <div class="interval-track" style={`--interval-left: ${row.ciLow / 2.2 * 100}%; --interval-width: ${(row.ciHigh - row.ciLow) / 2.2 * 100}%; --point-left: ${row.spread / 2.2 * 100}%`}><span class="interval-range"></span><span class="interval-point"></span></div>
          <div class="interval-values"><strong>+{row.spread.toFixed(2)}</strong><small><LocaleText as="span" text={c.range} /> {row.ciLow.toFixed(2)}<LocaleText as="span" text={c.between} />{row.ciHigh.toFixed(2)}</small></div>
          <small class="interval-legs"><LocaleText as="span" text={c.low} /> {row.low > 0 ? '+' : ''}{row.low.toFixed(2)}% · <LocaleText as="span" text={c.high} /> {row.high > 0 ? '+' : ''}{row.high.toFixed(2)}%</small>
        </div>)}</div>
        <LocaleText class="evidence-figure-note" text={c.uncertainty} /><LocaleText class="evidence-figure-note" text={c.controlsLimit} />
      </figure>
      <LocaleText text={c.regression} />
    </section>
    <section class="report-section">
      <LocaleText as="h3" text={c.interpretation} /><LocaleText text={c.interpretationLead} />
      <div class="research-grid">{[[c.volatility,c.volatilityText],[c.activity,c.activityText],[c.legs,c.legsText]].map(([title,text]) => <article class="research-card"><LocaleText as="h3" text={title} /><LocaleText text={text} /></article>)}</div>
    </section>
    <section class="report-section" data-testid="low-turnover-limits"><LocaleText as="h3" text={c.limitations} />
      <LocaleText text={c.sampleLimit} /><LocaleText text={c.historyLimit} /><LocaleText text={c.forwardLimit} /><LocaleText text={c.tradingLimit} />
    </section>
    <span id="research-method" class="anchor-target"></span><LowTurnoverExecutionEvidence client:load />
    <section class="report-section report-next"><LocaleText as="span" class="section-kicker" text={c.next} /><LocaleText as="h3" text={c.nextTitle} /><LocaleText text={c.nextText} /></section>
    <ClaimReview topic="low-turnover" />
    <details class="report-section"><summary><LocaleText as="span" text={c.versions} /></summary><LocaleText text={c.versionNote} />
      <dl><dt><LocaleText as="span" text={c.manifest} /></dt><dd><code>{evidence.manifestSha256}</code></dd><dt><LocaleText as="span" text={c.summary} /></dt><dd><code>{evidence.summarySha256}</code></dd></dl>
    </details>
    <nav class="report-links" aria-label="Low-turnover research links"><a class="button-link" href={docsUrl}><LocaleText as="span" text={c.method} /></a><a class="button-link secondary" href={withBase('/research/style-factors-18y/', base)}><LocaleText as="span" text={c.style} /></a></nav>
  </article>
</SiteLayout>

<style>
  details dd { margin-inline-start: 0; }
  details code { overflow-wrap: anywhere; }
</style>

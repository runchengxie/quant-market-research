---
import { PUBLIC_ROUTES, withBase } from '../../../../lib/routes';
const canonical = withBase(PUBLIC_ROUTES.cashflow, import.meta.env.BASE_URL);
const target = withBase(PUBLIC_ROUTES.cashflowRecovery, import.meta.env.BASE_URL);
---
<!doctype html>
<html lang="en-US"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Cash-flow index research · moved</title><link rel="canonical" href={new URL(canonical, Astro.site)} />
<noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
</head><body><p>Drawdowns and recovery are now part of <a href={target}>Cash-flow index research</a>.</p>
<script is:inline define:vars={{ canonical }}>
  const destination = new URL(canonical, window.location.origin);
  destination.search = window.location.search;
  destination.hash = window.location.hash || 'cashflow-recovery';
  window.location.replace(destination.href);
</script>
</body></html>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import T from '../../../components/LocaleText.astro';
import Chart from '../../../components/CashflowReplicationChart.astro';
import { replicationCopy as c } from '../../../content/cashflow-replication';
import { readerCopy } from '../../../content/cashflow-reader';
import type { Copy } from '../../../content/research-reading';
import { withBase } from '../../../lib/routes';
import study from '../../../../public/data/cashflow-replication/study.json';
import exploration from '../../../../public/data/cashflow-replication/exploration.json';
import navigation from '../../../../public/data/cashflow-replication/navigation.json';
import publication from '../../../../public/data/cashflow-replication/publication.json';
import migration from '../../../../public/data/cashflow-replication/migration.json';
import '../../../styles/cashflow-replication.css';
const en=study.translations['en-US'];
const pair=readerCopy;
const b=(v:{'en-US':string;'zh-CN':string}):Copy=>pair(v['en-US'],v['zh-CN']);
const base=import.meta.env.BASE_URL;
const sourceLink=(id:string)=>'#source-'+id;
const headings=[['calibration',c.calibration],['shadow-comparisons',c.charts],['research-steps',c.steps],['trust',c.trust],['next',c.next],['sources',c.sources]] as const;
---
<SiteLayout title={pair(en.title,study.title)[1]} titleEn={pair(en.title,study.title)[0]} description={pair(en.summary,study.summary)[0]} section="research">
  <article class="replication-report">
    <a class="replication-back" href={withBase('/research/cashflow/',base)}>← <T as="span" text={c.back}/></a>
    <header class="theme-heading"><div><T class="section-kicker" as="span" text={pair(en.status_label,study.status_label)}/><h1><T as="span" text={pair(en.title,study.title)}/></h1><T text={c.intro}/><p class="replication-reviewed"><T as="span" text={c.reviewed}/> · <time datetime={exploration.reviewed_at}>{exploration.reviewed_at}</time></p></div></header>
    <section class="replication-verdict" aria-labelledby="replication-findings"><h2 id="replication-findings"><T as="span" text={c.findings}/></h2><T text={pair(en.summary,study.summary)}/><ul>{study.findings.map((finding,i)=><li><T as="span" text={pair(en.findings[i],finding)}/></li>)}</ul><div class="replication-limit"><T as="h3" text={c.limits}/><ul>{study.limits.map((limit,i)=><li><T as="span" text={pair(en.limits[i],limit)}/></li>)}</ul></div></section>
    <nav class="replication-nav" aria-label="Report sections" data-locale-aria data-aria-en="Report sections" data-aria-zh="报告章节">{headings.map(([id,title])=><a href={'#'+id}><T as="span" text={title}/></a>)}</nav>
    <section id="calibration"><h2><T as="span" text={c.calibration}/></h2><div class="replication-coefficients">{study.rows.map((row,i)=><div><T as="span" text={pair(en.rows[i][0],row[0])}/><span class="coefficient-value">{row[1]}</span></div>)}</div><h3><T as="span" text={c.coefficient}/></h3><T text={c.coefficientText}/><dl class="replication-facts">{(['sample','scope','baseline','input_basis'] as const).map(key=><div><dt><T as="span" text={key==='input_basis'?c.input:c[key]}/></dt><dd><T as="span" text={b(study.evidence_summary[key])}/></dd></div>)}</dl><T text={pair(en.period,study.period)}/>
      <div class="table-scroll"><table><thead><tr>{study.columns.map((column,i)=><th><T as="span" text={pair(en.columns[i],column)}/></th>)}</tr></thead><tbody>{study.rows.map((row,i)=><tr>{row.map((cell,j)=><td><T as="span" text={pair(en.rows[i][j],cell)}/></td>)}</tr>)}</tbody></table></div>
    </section>
    <section class="replication-coverage" aria-labelledby="coverage-heading"><h2 id="coverage-heading"><T as="span" text={c.coverage}/></h2><T text={c.coverageIntro}/><ol>{[[c.methodDate,c.methodNote],[c.memberDate,c.memberNote],[c.weightDate,c.weightNote]].map(([date,note])=><li><T as="h3" text={date}/><T text={note}/></li>)}</ol></section>
    <section id="shadow-comparisons"><h2><T as="span" text={c.charts}/></h2><details class="replication-terms" open><summary><T as="span" text={c.terms}/></summary><dl>{[[c.portfolioTerm,c.portfolioDef],[c.weightTerm,c.weightDef],[c.turnoverTerm,c.turnoverDef],[c.pointTerm,c.pointDef]].map(([term,meaning])=><div><dt><T as="span" text={term}/></dt><dd><T as="span" text={meaning}/></dd></div>)}</dl></details>{exploration.charts.map(chart=><Chart chart={chart}/>)}{publication.comparison_groups.map(group=><details class="replication-comparison"><summary><T as="span" text={b(group.label)}/></summary><T text={b(group.scope)}/><p><T as="span" text={c.reviewed}/> · {group.reviewed_at}</p><code>{group.id} · {group.baseline_id} · {group.chart_id}</code></details>)}</section>
    <section id="research-steps"><h2><T as="span" text={c.steps}/></h2><T text={b(exploration.summary)}/><ol class="replication-steps">{exploration.steps.map((step,index)=><li data-research-step={step.id}><span class="replication-step-number">0{index+1}</span><div><T class="replication-period" text={b(step.period)}/><h3><T as="span" text={b(step.title)}/></h3><dl>{(['question','finding','decision'] as const).map(key=><div><dt><T as="span" text={c[key]}/></dt><dd><T as="span" text={b(step[key])}/></dd></div>)}</dl><p class="replication-source-links"><T as="span" text={c.source}/> · {step.source_ids.map(id=><a href={sourceLink(id)}>{id}</a>)}</p></div></li>)}</ol></section>
    <section id="trust"><h2><T as="span" text={c.trust}/></h2><div class="replication-trust">{navigation.trust.map(item=><article><h3><T as="span" text={c[item.dimension as keyof typeof c]}/></h3><span class="replication-status"><T as="span" text={c[item.status as keyof typeof c]}/></span><T text={b(item.detail)}/></article>)}</div><details class="replication-reproduction"><summary><T as="span" text={c.reproduction}/></summary><p><T as="span" text={c.partial}/></p><p><T as="span" text={c.run}/> · <code>{navigation.reproduction.run_id}</code></p><T text={b(navigation.reproduction.data_version)}/><T as="h3" text={c.missing}/><T text={b(navigation.reproduction.missing)}/><T text={c.runUnknown}/></details></section>
    <section id="next"><h2><T as="span" text={c.next}/></h2><T text={b(exploration.next_question)}/><p class="replication-boundary"><T as="span" text={c.research_only}/> · <T as="span" text={b(navigation.resume_when)}/></p>{navigation.next_tasks.map(task=><article class="replication-task"><span class="replication-status">{task.priority} · <T as="span" text={c.blocked}/></span><T text={b(task.action)}/><T as="h3" text={c.gate}/><T text={b(task.acceptance)}/></article>)}<h3><T as="span" text={c.changes}/></h3>{exploration.conclusion_changes.map(change=><div class="replication-change"><T class="replication-period" text={b(change.period)}/><dl>{(['before','trigger','after'] as const).map(key=><div><dt><T as="span" text={c[key]}/></dt><dd><T as="span" text={b(change[key])}/></dd></div>)}</dl><p class="replication-source-links">{change.source_ids.map(id=><a href={sourceLink(id)}>{id}</a>)}</p></div>)}</section>
    <section id="sources"><h2><T as="span" text={c.sources}/></h2><T class="replication-boundary" text={c.migration}/><T text={pair(en.source_note,study.source_note)}/>
      <ul class="replication-sources">{exploration.sources.map(source=><li id={'source-'+source.id}><T as="strong" text={b(source.label)}/><code>{source.source_ref}</code></li>)}</ul>
      <details><summary><T as="span" text={c.versions}/></summary><dl><dt><T as="span" text={c.explorationVersion}/></dt><dd><code>{exploration.source_revision}</code></dd><dt><T as="span" text={c.navigationVersion}/></dt><dd><code>{navigation.source_revision}</code></dd></dl><p><T as="span" text={c.priorStatus}/> · {study.source_review_status.status} · {study.source_review_status.checked_at}</p></details>
      <h3><T as="span" text={c.download}/></h3><ul class="replication-downloads">{migration.assets.map(asset=><li><a href={withBase('/data/cashflow-replication/'+asset.path,base)}>{asset.path}</a></li>)}<li><a href={withBase('/data/cashflow-replication/migration.json',base)}>migration.json</a></li></ul>
      <details><summary><T as="span" text={c.fingerprints}/></summary>{migration.assets.map(asset=><p><strong>{asset.path}</strong><br/><code>{asset.sha256}</code></p>)}<p><code>{navigation.authority_ref}</code></p><T text={pair('The original publication contract and source hashes are retained in publication.json. Missing run hashes remain missing.','原发布契约和来源哈希保留于 publication.json；原本缺失的运行哈希仍标为缺失。')}/></details>
      <h3><T as="span" text={c.related}/></h3><ul>{study.related_studies.map(item=><li><a href={'https://runchengxie.github.io/quant-factor-observatory/studies/'+item.study_id}>{item.study_id}</a><T text={b(item.rationale)}/></li>)}</ul>
    </section>
  </article>
</SiteLayout>

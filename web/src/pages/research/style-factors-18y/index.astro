---
import ResearchPage from "../../../components/ResearchPage.astro";
import { StylePage } from "../../../components/react/style-page";
import BarraNarrative from "../../../components/research/BarraNarrative.astro";
import FactorContextLink from "../../../components/FactorContextLink.astro";
---
<ResearchPage compact title="18 年 A 股风格因子研究" titleEn="18-year A-share style factors" description="探索 19 个风格因子的年度收益、特征定义与验证边界。" snapshotKey="barra" activeRoute="style" kicker="长期风格研究 · FACTOR EXPLORER" kickerEn="Long-run style research · FACTOR EXPLORER" introduction="选择一个因子，先看历史表现，再了解它衡量什么、如何计算。" introductionEn="Choose a factor to review its historical performance, definition, and calculation before examining its limits." boundary="历史多空合成收益，不代表实际账户盈亏。各因子样本不同；原始公式、PIT 与可交易性仍需核验。" boundaryEn="Historical long-short composite returns do not represent account P&L. Samples differ by factor; formulas, point-in-time integrity, and tradability remain to be checked." evidence="历史经验研究" evidenceEn="Historical empirical research" question="不同风格因子在 A 股历史中如何变化，收益之间有多少重合？" questionEn="How have style factors changed through A-share history, and how much do their returns overlap?" nextStep="核验历史生成链路，并按修正后的形成日分组与缺失收益政策重算可追溯结果。" nextStepEn="Audit the historical generation chain and recompute traceable results under corrected formation dates and missing-return rules.">
  <StylePage client:load scope="barra" />
  <p class="method-link" data-document-title="Barra 风格因子字典"><FactorContextLink target="/docs/research/factors/barra-factor-dictionary/" label="阅读完整因子定义" labelEn="Read full factor definitions" base={import.meta.env.BASE_URL} /></p>
  <details class="panel methodology-section">
    <summary data-locale-text data-en="Research methods: sample, return definitions, and interpretation limits" data-zh="研究问题与方法：样本范围、计算口径与解释边界">Research methods: sample, return definitions, and interpretation limits</summary>
    <p data-locale-text data-en="Eighteen years of A-share style-factor history: returns, stability, and market regimes. This page describes how factor groups behaved across market regimes. IC, out-of-sample validation, and statistical significance remain to be added." data-zh="18 年 A 股风格因子动态：收益、稳定性与市场阶段。读者可以了解各类风格因子在不同市场阶段的表现；IC、样本外验证和统计显著性仍待补充。">Eighteen years of A-share style-factor history: returns, stability, and market regimes. This page describes how factor groups behaved across market regimes. IC, out-of-sample validation, and statistical significance remain to be added.</p>
    <BarraNarrative />
  </details>
</ResearchPage>

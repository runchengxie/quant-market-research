---
import ResearchPage from "../../../components/ResearchPage.astro";
import { StylePage } from "../../../components/react/style-page";
import MarketStyleNarrative from "../../../components/research/MarketStyleNarrative.astro";
import FactorContextLink from "../../../components/FactorContextLink.astro";
---
<ResearchPage compact showConclusion title="18 年 A 股市场风格分析" titleEn="18-year A-share Market Style Analysis" description="查看 19 个风格因子的历史表现、逐年变化、相互重合与研究边界。" snapshotKey="barra" activeRoute="style" kicker="长期风格研究 · FACTOR EXPLORER" kickerEn="Long-run style research · FACTOR EXPLORER" introduction="研究按月分五组比较 19 项 A 股风格因子的高低分组。" introductionEn="Each month, the study compares high and low score groups across 19 A-share style factors." boundary="图中历史多空序列不等同于账户收益。因子覆盖期不同，历史生成链路和公式对应关系也未完全核实。" boundaryEn="Historical long-short series are not account returns. Factor coverage differs, and the original generation chain and formula mappings are not fully verified." evidence="历史档案与描述性研究" evidenceEn="Historical archive and descriptive study" question="哪些风格特征在历史上更常见，哪些只是阶段性表现？" questionEn="Which style characteristics appear more consistently, and which results are concentrated in certain periods?" nextStep="先核实历史公式和缺失收益口径，再按可证明的形成日信息重算，并加入成本、停牌和涨跌停处理。" nextStepEn="First verify historical formulas and missing-return rules, then recompute using provable formation-date information and add costs, suspensions, and price-limit handling.">
  <StylePage client:load scope="style-factors" />
  <MarketStyleNarrative />
  <p class="method-link" data-document-title="市场风格因子字典"><FactorContextLink target="/docs/research/factors/barra-factor-dictionary/" label="阅读完整因子定义" labelEn="Read full factor definitions" base={import.meta.env.BASE_URL} /></p>
  <details class="panel methodology-section">
    <summary data-locale-text data-en="How to read IC and the decile study" data-zh="IC 与十分组研究怎么读">How to read IC and the decile study</summary>
    <p data-locale-text data-en="IC measures the cross-sectional relationship between a score and later returns; Rank IC measures whether their order agrees. A value near zero indicates little relationship in that sample. The separate size study sorts into ten groups and measures next-session returns; its direction and sample contract differ from the monthly five-group long-short archive above." data-zh="IC 衡量因子分数与后续收益在横截面上的关系，Rank IC 衡量两者排序是否一致。数值接近零，表示该样本中的关系较弱。补充的市值研究把股票分成十组并观察下一交易日收益，其方向和样本口径都与上方月度五组多空档案不同。">IC measures the cross-sectional relationship between a score and later returns; Rank IC measures whether their order agrees. A value near zero indicates little relationship in that sample. The separate size study sorts into ten groups and measures next-session returns; its direction and sample contract differ from the monthly five-group long-short archive above.</p>
  </details>
</ResearchPage>

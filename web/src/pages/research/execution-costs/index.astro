---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ExecutionReport from "../../../components/ExecutionReport.astro";
import { executionCostCopy as copy } from "../../../content/execution-cost-copy";
import { liquidityResearchCopy as c } from "../../../content/liquidity-research-copy";
import { withBase } from "../../../lib/routes";
---
<SiteLayout title={copy.title[1]} titleEn={copy.title[0]} description={copy.question[0]} section="research">
<p class="report-links"><a href={withBase('/research/liquidity/#expanded-results',import.meta.env.BASE_URL)} data-locale-link data-href-en={withBase("/research/liquidity/?lang=en-US#expanded-results",import.meta.env.BASE_URL)} data-href-zh={withBase("/research/liquidity/?lang=zh-CN#expanded-results",import.meta.env.BASE_URL)} data-locale-text data-en={c.unifiedLink[0]} data-zh={c.unifiedLink[1]}>{c.unifiedLink[0]}</a></p>
<ExecutionReport />
</SiteLayout>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import LegacyHashRedirect from "../components/LegacyHashRedirect.astro";
import FreshnessStrip from "../components/FreshnessStrip.astro";
import { OverviewContent } from "../components/ResearchOverview";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import type { Snapshot } from "../components/recovery-data";

const recovery = JSON.parse(await readFile(resolve(process.cwd(), "public/data/research/recovery.json"), "utf8")) as Snapshot;
const barra = JSON.parse(await readFile(resolve(process.cwd(), "public/data/barra/barra_summary.json"), "utf8"));
const manifest = JSON.parse(await readFile(resolve(process.cwd(), "public/data/manifest.json"), "utf8"));
---

<SiteLayout title="研究总览" titleEn="Research overview" description="An overview of historical market research and public data." activeRoute="overview">
  <LegacyHashRedirect />
  <OverviewContent recovery={recovery} barra={barra} />
  <FreshnessStrip snapshot={manifest.snapshots?.overview ?? {}} snapshotKey="overview" label="公开快照总览" />
</SiteLayout>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SearchResults from '../../components/react/SearchResults';
---
<SiteLayout title="搜索" titleEn="Search" description="Search public research, methods, and factor definitions." section="docs">
  <section class="theme-heading"><div><span class="section-kicker" data-locale-text data-en="Public search" data-zh="公开内容搜索">Public search</span><h1 data-locale-text data-en="Search research, methods, and factor definitions" data-zh="搜索研究、方法与因子定义">Search research, methods, and factor definitions</h1><p data-locale-text data-en="Search covers the public registry, seven documentation pages, and versioned factor records. It does not read internal specifications or raw data." data-zh="搜索只覆盖公开注册表、七篇说明文档和版本化因子记录，不读取内部规格或原始数据。">Search covers the public registry, seven documentation pages, and versioned factor records. It does not read internal specifications or raw data.</p></div></section>
  <SearchResults client:load base={import.meta.env.BASE_URL} />
</SiteLayout>

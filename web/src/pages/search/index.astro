---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SearchResults from '../../components/react/SearchResults';
---
<SiteLayout title="搜索" titleEn="Search" description="Search public research, methods, and factor definitions." section="docs">
  <section class="theme-heading"><div><span class="section-kicker" data-locale-text data-en="Public search" data-zh="公开内容搜索">Public search</span><h1 data-locale-text data-en="Search research, methods, and factor definitions" data-zh="搜索研究、方法与因子定义">Search research, methods, and factor definitions</h1><p data-locale-text data-en="Search covers public research and factor records, plus the introduction, headings and excerpts from public method sections. Results link to the matching section. Internal specifications and raw data are excluded." data-zh="搜索覆盖公开研究、因子记录及公开方法说明的导语、标题和各节摘要，结果可直接定位到对应章节。不读取内部规格或原始数据。">Search covers public research and factor records, plus the introduction, headings and excerpts from public method sections. Results link to the matching section. Internal specifications and raw data are excluded.</p></div></section>
  <SearchResults client:load base={import.meta.env.BASE_URL} />
</SiteLayout>

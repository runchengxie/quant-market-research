---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="页面不存在" titleEn="Page not found" description="This research page is temporarily unavailable.">
  <section class="theme-heading">
    <div>
      <span class="section-kicker" data-locale-text data-en="404 · Page not found" data-zh="404 · 页面不存在">404 · Page not found</span>
      <h1 data-locale-text data-en="This page could not be found" data-zh="暂时找不到这个页面">This page could not be found</h1>
      <p data-locale-text data-en="The address may have changed. Browse the research overview to find a topic." data-zh="地址可能已经调整。可以从研究总览重新进入各个专题。">The address may have changed. Browse the research overview to find a topic.</p>
      <a href="/quant-market-research/" data-locale-text data-en="Back to research overview ↗" data-zh="返回研究总览 ↗">Back to research overview ↗</a>
    </div>
  </section>
</SiteLayout>

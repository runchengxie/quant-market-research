---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { readPublicDocuments } from '../../content/public-docs-loader';
import { expandPublicFragments } from '../../content/public-fragments.server';
import { readFactorRecords } from '../../content/factor-records.server';
import { publicDocs } from '../../content/public-registry';
import { publicDocsTransform } from '../../content/rehype-public-docs';
import { legacyAnchorMap } from '../../content/legacy-anchor-map';
import { resolve } from 'node:path';

export async function getStaticPaths() {
  return publicDocs.filter((doc) => doc.slug).map((doc) => ({ params: { slug: doc.slug }, props: { id: doc.id } }));
}

const { id } = Astro.props;
const repoRoot = resolve(process.cwd(), '..');
const documents = await readPublicDocuments(repoRoot);
const document = documents.find((item) => item.meta.id === id);
if (!document) throw new Error(`public document not found: ${id}`);
const records = await readFactorRecords(repoRoot);
const processor = await createMarkdownProcessor({ rehypePlugins: [[publicDocsTransform, import.meta.env.BASE_URL]] });
async function renderDocument(item: typeof document) {
  const rendered = await processor.render(expandPublicFragments(item!.body, records), { fileURL: new URL(`../../../../${item!.meta.source}`, import.meta.url) });
  const legacyIds = legacyAnchorMap[item!.meta.source] ?? [];
  let index = 0;
  const html = rendered.code.replace(/(<h[1-6]\b[^>]*\bid=")[^"]+("[^>]*>)/g, (whole, prefix, suffix) => legacyIds[index++] ? `${prefix}${legacyIds[index - 1]}${suffix}` : whole);
  const headings = rendered.metadata.headings.map((heading, i) => legacyIds[i] ? { ...heading, slug: legacyIds[i] } : heading);
  return {html, headings};
}
const primary = await renderDocument(document);
const isChinese = document.meta.id.endsWith('-zh-CN');
const companionId = isChinese ? document.meta.id.slice(0, -6) : `${document.meta.id}-zh-CN`;
const companion = documents.find(item => item.meta.id === companionId);
const alternate = companion ? {...await renderDocument(companion), locale: isChinese ? 'en-US' : 'zh-CN'} : undefined;
---
<ArticleLayout meta={document.meta} html={primary.html} headings={primary.headings} documentLocale={isChinese ? 'zh-CN' : 'en-US'} alternate={alternate} />

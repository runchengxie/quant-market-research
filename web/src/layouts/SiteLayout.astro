---
import "../styles.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  titleEn?: string;
  description: string;
  activeRoute?: string;
  section?: "overview" | "research" | "docs" | "data";
  workbench?: boolean;
}

const { title, titleEn = title, description, activeRoute = "overview", section, workbench = false } = Astro.props;
const pageTitle = `${titleEn} · Quant Market Research`;
---

<!doctype html>
<html lang="en-US" data-title-en={pageTitle} data-title-zh={`${title} · Quant Market Research`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("market-research-theme");
          const choice = stored === "dark" || stored === "light" || stored === "system" ? stored : "system";
          const dark = choice === "dark" || (choice === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <div class:list={["app", { "research-workbench": workbench }]}>
      <SiteHeader activeRoute={activeRoute} section={section} />
      <a class="skip-link" href="#main-content" data-locale-text data-en="Skip to content" data-zh="跳到正文">Skip to content</a>
      <main id="main-content" class="site-main"><slot /></main>
      <SiteFooter />
    </div>
  </body>
  <script is:inline>
    (() => {
      const storageKey = "quant-market-research-locale";
      let stored = null;
      try { stored = localStorage.getItem(storageKey); } catch { /* storage is optional */ }
      const locale = stored === "zh-CN" ? "zh-CN" : "en-US";
      document.documentElement.lang = locale;
      document.documentElement.dataset.locale = locale;
      const title = document.documentElement.getAttribute(locale === "en-US" ? "data-title-en" : "data-title-zh");
      if (title) document.title = title;
      document.querySelectorAll("[data-locale-text]").forEach((node) => {
        const value = node.getAttribute(locale === "en-US" ? "data-en" : "data-zh");
        if (value) node.textContent = value;
      });
      const toggle = document.querySelector("[data-locale-toggle]");
      if (toggle) {
        toggle.textContent = locale === "en-US" ? "中文" : "English";
        toggle.setAttribute("aria-label", locale === "en-US" ? "Switch to Chinese" : "切换到英文");
        toggle.addEventListener("click", () => {
          const next = document.documentElement.lang === "en-US" ? "zh-CN" : "en-US";
          try { localStorage.setItem(storageKey, next); } catch { /* storage is optional */ }
          window.location.reload();
        });
      }
    })();
  </script>
</html>

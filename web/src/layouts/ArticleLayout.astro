---
import SiteLayout from './SiteLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FactorContextLink from '../components/FactorContextLink.astro';
import { withBase } from '../lib/routes';
import { englishCopy } from '../content/locale-copy';
const { meta, html, headings = [] } = Astro.props as { meta: { id: string; title: string; summary: string }; html: string; headings: Array<{ depth: number; slug: string; text: string }> };
const localized = englishCopy(meta);
---
<SiteLayout title={meta.title} titleEn={localized.title} description={meta.summary} section="docs">
  <Breadcrumbs items={[{ label: '方法与字典', labelEn: 'Methods and dictionary', href: withBase('/docs/', import.meta.env.BASE_URL) }, { label: meta.title, labelEn: localized.title }]} />
  <article class="article-body public-article">
    <div class="article-content" set:html={html}></div>
    {meta.id === 'barra-factor-dictionary' && <p><FactorContextLink target="/research/style-factors-18y/" label="回到因子图表" labelEn="Back to factor charts" base={import.meta.env.BASE_URL} /></p>}
    {headings.length > 2 && <aside class="article-toc" aria-label="Table of contents"><strong data-locale-text data-en="On this page" data-zh="本文目录">On this page</strong><ol>{headings.filter((heading) => heading.depth > 1).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>}
  </article>
</SiteLayout>

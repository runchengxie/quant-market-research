---
import SiteLayout from './SiteLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FactorContextLink from '../components/FactorContextLink.astro';
import { withBase } from '../lib/routes';
import { englishCopy } from '../content/locale-copy';
type Heading = {depth: number; slug: string; text: string};
interface Props { meta: {id: string; title: string; summary: string}; html: string; headings?: Heading[]; documentLocale?: string; alternate?: {html: string; headings: Heading[]; locale: string} }
const { meta, html, headings = [], documentLocale = 'en-US', alternate } = Astro.props;
const localized = englishCopy(meta);
---
<SiteLayout title={meta.title} titleEn={localized.title} description={meta.summary} section="docs">
  <Breadcrumbs items={[{ label: '方法与字典', labelEn: 'Methods and dictionary', href: withBase('/docs/', import.meta.env.BASE_URL) }, { label: meta.title, labelEn: localized.title }]} />
  <article class="article-body public-article">
    <div data-document-body data-document-locale={documentLocale}>
      <div class="article-content" data-valuation-panel={meta.id.startsWith('valuation-panel') ? 'true' : undefined} data-valuation={meta.id.startsWith('valuation-denominators') ? 'true' : undefined} set:html={html}></div>
      {headings.length > 2 && <aside class="article-toc" aria-label="Table of contents" data-locale-aria data-aria-en="Table of contents" data-aria-zh="本文目录"><strong data-locale-text data-en="On this page" data-zh="本文目录">On this page</strong><ol>{headings.filter(h => h.depth > 1).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>}
    </div>
    {alternate && <template data-document-translation data-translation-locale={alternate.locale}>
      <div class="article-content" data-valuation-panel={meta.id.startsWith('valuation-panel') ? 'true' : undefined} data-valuation={meta.id.startsWith('valuation-denominators') ? 'true' : undefined} set:html={alternate.html}></div>
      {alternate.headings.length > 2 && <aside class="article-toc" aria-label="Table of contents" data-locale-aria data-aria-en="Table of contents" data-aria-zh="本文目录"><strong data-locale-text data-en="On this page" data-zh="本文目录">On this page</strong><ol>{alternate.headings.filter(h => h.depth > 1).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>}
    </template>}
    {meta.id.replace(/-zh-CN$/, '') === 'barra-factor-dictionary' && <p><FactorContextLink target="/research/style-factors-18y/" label="回到因子图表" labelEn="Back to factor charts" base={import.meta.env.BASE_URL} /></p>}
  </article>
  <script is:inline>
    (() => {
      const body = document.querySelector('[data-document-body]');
      const translation = document.querySelector('template[data-document-translation]');
      if (body && translation && translation.dataset.translationLocale === document.documentElement.lang) {
        body.replaceChildren(translation.content.cloneNode(true));
        body.dataset.documentLocale = translation.dataset.translationLocale;
      }
    })();
  </script>
</SiteLayout>

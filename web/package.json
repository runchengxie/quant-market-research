    "@types/node": "^22.20.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "astro": "^7.3.2",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "yaml": "2.9.1"

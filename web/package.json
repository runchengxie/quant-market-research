{
  "name": "market-research-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "snapshot": "node scripts/build-public-snapshot.mjs",
    "build": "astro check && astro build",
    "postbuild": "node scripts/write-nojekyll.mjs",
    "verify:static": "node --import tsx scripts/verify-static-site.mjs dist",
    "report:bundle": "node scripts/report-bundle-size.mjs dist",
    "e2e": "playwright test",
    "serve:preview": "node scripts/serve-static.mjs dist",
    "test": "node --import tsx --test src/*.test.mjs",
    "preview": "astro preview",
    "build:pages": "node scripts/build-pages.mjs",
    "import:rotation": "node --import tsx scripts/import-rotation-evidence.mjs",
    "import:rotation-release": "node --import tsx scripts/import-rotation-release.mjs",
    "prebuild": "node scripts/validate-reader-evidence.mjs && node scripts/validate-asset-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/dm-mono": "^5.3.0",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/react": "^7.1.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
